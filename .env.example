APPLE_LLM_MAX_NEW_TOKENS=256
APPLE_LLM_TRUST_REMOTE_CODE=false
APPLE_LLM_TIMEOUT_SECONDS=300
# ── Multi-model configuration ──
# APPLE_LLM_MODELS_JSON: JSON array to configure multiple models for Apple LLM serving
# When set, this OVERRIDES the single-model configuration above (APPLE_LLM_MODEL_PATH, APPLE_LLM_BACKEND, etc.)
# Each model can have its own backend (coreml, mlx), compute units, and token limits
#
# Required fields per model:
#   - model_id: unique identifier for routing requests
#   - model_path: absolute path to model directory
#   - backend: "coreml" or "mlx"
#
# Optional fields per model (inherit from APPLE_LLM_* vars if not specified):
#   - compute_units: "cpu_and_ne", "cpu_only", "all" (CoreML only)
#   - max_input_tokens: maximum input context length
#   - max_new_tokens: maximum generation length
#   - enable_thinking: true/false for extended reasoning
#   - tokenizer_path: custom tokenizer directory (if different from model_path)
#   - trust_remote_code: true/false for custom model code
#
# Examples:
#
# Basic multi-model setup (CoreML + MLX):
# APPLE_LLM_MODELS_JSON=[{"model_id":"qwen-2.5-7b","model_path":"/models/qwen-2.5-7b","backend":"coreml"},{"model_id":"llama-3.2-3b","model_path":"/models/llama-3.2-3b","backend":"mlx"}]
#
# Advanced configuration with per-model settings:
# APPLE_LLM_MODELS_JSON=[{"model_id":"qwen-2.5-7b-coreml","model_path":"/models/qwen-2.5-7b","backend":"coreml","compute_units":"cpu_and_ne","max_input_tokens":4096,"max_new_tokens":512},{"model_id":"llama-3.2-3b-mlx","model_path":"/models/llama-3.2-3b","backend":"mlx","max_input_tokens":2048,"max_new_tokens":256,"enable_thinking":true}]
#
# Multiple models with same backend:
# APPLE_LLM_MODELS_JSON=[{"model_id":"qwen-2.5-7b","model_path":"/models/qwen-2.5-7b","backend":"coreml","compute_units":"cpu_and_ne"},{"model_id":"qwen-2.5-3b","model_path":"/models/qwen-2.5-3b","backend":"coreml","compute_units":"all"}]
#
APPLE_LLM_MODELS_JSON=
