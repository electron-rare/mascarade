#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN_PATH="$SCRIPT_DIR/.local/bin/htop"

if [[ ! -x "$BIN_PATH" ]]; then
    echo "Repo-managed htop is not installed yet." >&2
    echo "Run ./setup or scripts/install_repo_htop.sh first." >&2
    exit 1
fi

exec "$BIN_PATH" "$@"
