{
  "version": "2026-03-14",
  "description": "Registry-first inventory for MCP surfaces referenced by mascarade code, docs, deploy modules, and local Codex config.",
  "classification_legend": {
    "official": "Vendor-maintained or curated official package/server.",
    "community-valid": "Public upstream community server with a credible maintained source, but not treated as the canonical official connector here.",
    "local-only": "Custom launcher or sibling-repo runtime without a public registry target for this workspace."
  },
  "registry_status_legend": {
    "curated-registry": "Seen in curated MCP registry/GitHub registry sources during this pass.",
    "vendor-official-upstream": "Official vendor source confirmed, but no curated-registry hit was captured in this pass.",
    "not-found-in-curated-registry-snapshot": "No curated-registry hit captured in this pass.",
    "local-custom": "Local custom runtime or wrapper."
  },
  "servers": [
    {
      "key": "notion",
      "label": "Notion MCP",
      "classification": "official",
      "registry_status": "curated-registry",
      "integration_scope": ["codex-config", "ops-notes"],
      "config_names": ["notion"],
      "expected_transport": "remote",
      "url_prefixes": ["https://mcp.notion.com/mcp"],
      "notes": [
        "Prefer the remote OAuth endpoint over legacy local notion MCP variants.",
        "Local Codex config should use the direct remote URL."
      ]
    },
    {
      "key": "huggingface",
      "label": "Hugging Face MCP",
      "classification": "official",
      "registry_status": "curated-registry",
      "integration_scope": ["codex-config", "ops-agent", "docs"],
      "config_names": ["huggingface"],
      "expected_transport": "remote",
      "url_prefixes": ["https://huggingface.co/mcp"],
      "notes": [
        "Remote server with bearer token auth.",
        "Ops agent already knows this endpoint as an optional remote surface."
      ]
    },
    {
      "key": "playwright",
      "label": "Playwright MCP",
      "classification": "official",
      "registry_status": "curated-registry",
      "integration_scope": ["codex-config", "operator-local"],
      "config_names": ["playwright"],
      "expected_transport": "local",
      "command_prefixes": ["npx"],
      "arg_contains": ["@playwright/mcp"],
      "notes": [
        "Canonical local install path stays the official Playwright package.",
        "Do not replace with an ad hoc browser wrapper."
      ]
    },
    {
      "key": "firecrawl",
      "label": "Firecrawl MCP",
      "classification": "official",
      "registry_status": "curated-registry",
      "integration_scope": ["deploy-optional", "ops-ui", "docs"],
      "config_names": ["firecrawl", "firecrawl-mcp", "mcp-server-firecrawl"],
      "expected_transport": "remote",
      "url_prefixes": ["https://mcp.firecrawl.dev/"],
      "notes": [
        "Repo deploys Firecrawl via the official image mcp/firecrawl.",
        "A local Codex config entry is optional and currently absent."
      ]
    },
    {
      "key": "mem0",
      "label": "Mem0 / OpenMemory MCP",
      "classification": "official",
      "registry_status": "vendor-official-upstream",
      "integration_scope": ["deploy-optional", "ops-ui", "docs"],
      "config_names": ["mem0", "openmemory", "openmemory-mcp", "mem0-memory-mcp"],
      "expected_transport": "remote",
      "url_prefixes": ["http://localhost:8765/", "https://"],
      "notes": [
        "Repo deploys OpenMemory through mem0/openmemory-mcp.",
        "Treat this as an official upstream surface, but keep the registry-status separate until a curated-registry hit is captured."
      ]
    },
    {
      "key": "kicad",
      "label": "KiCad MCP",
      "classification": "community-valid",
      "registry_status": "not-found-in-curated-registry-snapshot",
      "integration_scope": ["core-runtime", "ops-agent", "codex-config", "docs"],
      "config_names": ["kicad"],
      "expected_transport": "local",
      "command_prefixes": ["bash", "sh"],
      "arg_contains": ["Kill_LIFE/tools/hw/run_kicad_mcp.sh"],
      "repo_dir_env_keys": ["MASCARADE_DIR"],
      "notes": [
        "Current integration is a local launcher into Kill_LIFE and a vendored community KiCad MCP server.",
