#!/usr/bin/env bash
# config — Reconfiguration interactive Mascarade
# Usage : ./config [--help] [--verbose|-v]

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Charger les modules
source "$SCRIPT_DIR/scripts/lib.sh"
source "$SCRIPT_DIR/scripts/services.sh"
source "$SCRIPT_DIR/scripts/compose.sh"

for arg in "$@"; do
    case "$arg" in
        -v|--verbose)
            VERBOSE=true
            ;;
        -h|--help)
            echo "Usage: ./config [--help] [--verbose|-v]"
            echo ""
            echo "Reconfiguration interactive du .env Mascarade. Permet de modifier cles API, ports, integrations, cluster et CAD/KiCad par sections sans tout reinstaller."
            echo ""
            echo "Options :"
            echo "  -h, --help      Afficher cette aide et quitter"
            echo "  -v, --verbose   Afficher les traces de debug"
            exit 0
            ;;
        *)
            err "Option inconnue: $arg"
            echo "Utilise: ./config --help"
            exit 2
            ;;
    esac
done

dbg "=== config demarre ==="
dbg "  REPO_DIR=$REPO_DIR"
dbg "  SCRIPT_DIR=$SCRIPT_DIR"
_ensure_docker_access

if [[ ! -t 0 || ! -t 1 ]]; then
    err "Le mode interactif est requis (TTY introuvable). Utilise ./config --help pour les options."
    exit 1
fi

declare -Ag CONFIG_ORIG=()
declare -Ag CONFIG_SCOPE_TOUCHED=()
declare -ag ACTIVE_SERVICE_IDS=()
declare -ag CONFIG_CLUSTER_FIELDS=(
    CLUSTER_ENABLED NODE_ID NODE_ROLE NODE_LABEL MESH_BIND_HOST MESH_SCHEME
    CLUSTER_SHARED_KEY CLUSTER_REQUEST_TIMEOUT_MS CLUSTER_HEARTBEAT_SECONDS
    CLUSTER_FORWARD_ENABLED CLUSTER_PEERS
)
declare -ag CONFIG_CAD_FIELDS=(
    KICAD_VERSION KICAD_PLUGIN_DIR CAD_WORKSPACE_DIR CAD_INSTALL_BUNDLES
)
declare -ag CONFIG_PORT_FIELDS=(
    PUBLISH_BIND_HOST CORE_PORT API_PORT POSTGRES_PORT REDIS_PORT CLICKHOUSE_HTTP_PORT CLICKHOUSE_NATIVE_PORT OLLAMA_PORT OPEN_WEBUI_PORT EDGE_PROXY_BIND_HOST EDGE_PROXY_HTTP_PORT EDGE_PROXY_HTTPS_PORT
    LITELLM_PORT N8N_PORT LANGFUSE_PORT DIFY_API_PORT DIFY_WEB_PORT TTS_PORT STT_PORT
    GENERATE_AUDIO_PORT QDRANT_PORT QDRANT_GRPC_PORT GRAFANA_PORT PROMETHEUS_PORT
)
declare -Ag CONFIG_PORT_LABEL=(
    [PUBLISH_BIND_HOST]="Bind host global"
    [CORE_PORT]="Port Core (FastAPI)"
    [API_PORT]="Port API (Hono)"
    [POSTGRES_PORT]="Port PostgreSQL"
    [REDIS_PORT]="Port Redis"
    [CLICKHOUSE_HTTP_PORT]="Port ClickHouse HTTP"
    [CLICKHOUSE_NATIVE_PORT]="Port ClickHouse native"
    [OLLAMA_PORT]="Port Ollama"
    [OPEN_WEBUI_PORT]="Port Open WebUI"
    [EDGE_PROXY_BIND_HOST]="Bind Edge Proxy"
    [EDGE_PROXY_HTTP_PORT]="Port HTTP Edge Proxy"
    [EDGE_PROXY_HTTPS_PORT]="Port HTTPS Edge Proxy"
    [LITELLM_PORT]="Port LiteLLM"
    [N8N_PORT]="Port n8n"
    [LANGFUSE_PORT]="Port Langfuse"
    [DIFY_API_PORT]="Port Dify API"
    [DIFY_WEB_PORT]="Port Dify Web"
    [TTS_PORT]="Port TTS"
    [STT_PORT]="Port STT"
    [GENERATE_AUDIO_PORT]="Port Generate Audio"
    [QDRANT_PORT]="Port Qdrant"
    [QDRANT_GRPC_PORT]="Port Qdrant gRPC"
    [GRAFANA_PORT]="Port Grafana"
    [PROMETHEUS_PORT]="Port Prometheus"
)
declare -Ag CONFIG_PORT_SERVICE=(
    [PUBLISH_BIND_HOST]="core"
    [CORE_PORT]="core"
    [API_PORT]="api"
    [POSTGRES_PORT]="postgres"
    [REDIS_PORT]="redis"
    [CLICKHOUSE_HTTP_PORT]="clickhouse"
    [CLICKHOUSE_NATIVE_PORT]="clickhouse"
    [OLLAMA_PORT]="ollama"
    [OPEN_WEBUI_PORT]="open-webui"
    [EDGE_PROXY_BIND_HOST]="edge-proxy"
    [EDGE_PROXY_HTTP_PORT]="edge-proxy"
    [EDGE_PROXY_HTTPS_PORT]="edge-proxy"
    [LITELLM_PORT]="litellm"
    [N8N_PORT]="n8n"
    [LANGFUSE_PORT]="langfuse"
    [DIFY_API_PORT]="dify"
    [DIFY_WEB_PORT]="dify"
    [TTS_PORT]="tts"
    [STT_PORT]="stt"
    [GENERATE_AUDIO_PORT]="generate-audio"
    [QDRANT_PORT]="qdrant"
    [QDRANT_GRPC_PORT]="qdrant"
    [GRAFANA_PORT]="grafana"
    [PROMETHEUS_PORT]="prometheus"
)

config_mark_scope() {
    CONFIG_SCOPE_TOUCHED["$1"]="1"
}

config_field_default() {
    local var="$1"
    local service="$2"
    case "$var" in
        PUBLISH_BIND_HOST)
            echo "${PUBLISH_BIND_HOST:-0.0.0.0}"
            ;;
        CLICKHOUSE_HTTP_PORT)
            echo "${CLICKHOUSE_HTTP_PORT:-8123}"
            ;;
        CLICKHOUSE_NATIVE_PORT)
            echo "${CLICKHOUSE_NATIVE_PORT:-9000}"
            ;;
        EDGE_PROXY_BIND_HOST)
            echo "${EDGE_PROXY_BIND_HOST:-0.0.0.0}"
            ;;
        EDGE_PROXY_HTTP_PORT)
            echo "${EDGE_PROXY_HTTP_PORT:-80}"
            ;;
        EDGE_PROXY_HTTPS_PORT)
            echo "${EDGE_PROXY_HTTPS_PORT:-443}"
            ;;
        QDRANT_GRPC_PORT)
            echo "${QDRANT_GRPC_PORT:-6334}"
            ;;
        *)
            echo "${SVC_PORT[$service]}"
            ;;
    esac
}

collect_active_service_ids() {
    ACTIVE_SERVICE_IDS=()
    local id
    for id in "${SVC_IDS[@]}"; do
        svc_selected "$id" && ACTIVE_SERVICE_IDS+=("$id")
    done

    return 0
}

capture_config_snapshot() {
    local vars=(
        ANTHROPIC_API_KEY OPENAI_API_KEY GOOGLE_API_KEY MISTRAL_API_KEY GROQ_API_KEY
        DEFAULT_LLM_PROVIDER DEFAULT_LLM_MODEL MASCARADE_API_KEY
        CLUSTER_ENABLED NODE_ID NODE_ROLE NODE_LABEL MESH_BIND_HOST MESH_SCHEME
        CLUSTER_SHARED_KEY CLUSTER_REQUEST_TIMEOUT_MS CLUSTER_HEARTBEAT_SECONDS
        CLUSTER_FORWARD_ENABLED CLUSTER_PEERS
        KICAD_VERSION KICAD_PLUGIN_DIR CAD_WORKSPACE_DIR CAD_INSTALL_BUNDLES
        NOTION_API_KEY COMFYUI_URL COMFYUI_LOCAL
        PUBLISH_BIND_HOST CORE_PORT API_PORT POSTGRES_PORT REDIS_PORT CLICKHOUSE_HTTP_PORT CLICKHOUSE_NATIVE_PORT OLLAMA_PORT OPEN_WEBUI_PORT EDGE_PROXY_BIND_HOST EDGE_PROXY_HTTP_PORT EDGE_PROXY_HTTPS_PORT
        LITELLM_PORT N8N_PORT LANGFUSE_PORT DIFY_API_PORT DIFY_WEB_PORT TTS_PORT STT_PORT
        GENERATE_AUDIO_PORT QDRANT_PORT QDRANT_GRPC_PORT GRAFANA_PORT PROMETHEUS_PORT
    )
    local var service
    for var in "${vars[@]}"; do
        CONFIG_ORIG["$var"]="${!var:-}"
    done

    for var in "${CONFIG_PORT_FIELDS[@]}"; do
        service="${CONFIG_PORT_SERVICE[$var]}"
        CONFIG_ORIG["$var"]="${!var:-$(config_field_default "$var" "$service")}"
        printf -v "$var" '%s' "${CONFIG_ORIG[$var]}"
    done
}

value_changed() {
    local var="$1"
    [[ "${CONFIG_ORIG[$var]:-}" != "${!var:-}" ]]
}

mask_config_value() {
    local value="${1:-}"
    if [[ -z "$value" ]]; then
        echo "absent"
    elif (( ${#value} <= 8 )); then
        echo "***"
    else
        printf '%s...%s' "${value:0:6}" "${value: -4}"
    fi
}

show_active_stack_overview() {
    section "Stack active"
    collect_active_service_ids
    if [[ ${#ACTIVE_SERVICE_IDS[@]} -eq 0 ]]; then
        warn "Aucun service detecte dans docker-compose.yml."
        return 0
    fi
    show_service_selection_summary "${ACTIVE_SERVICE_IDS[@]}"

    return 0
}

config_default_kicad_plugin_dir() {
    local version="${KICAD_VERSION:-9.0}"
    if is_macos; then
        printf '%s/Library/Application Support/kicad/%s/scripting/plugins\n' "$HOME" "$version"
    else
        printf '%s/.config/kicad/%s/scripting/plugins\n' "$HOME" "$version"
    fi
}

config_effective_cad_workspace_dir() {
    if [[ -n "${CAD_WORKSPACE_DIR:-}" ]]; then
        echo "$CAD_WORKSPACE_DIR"
    else
        echo "$REPO_DIR"
    fi
}

configure_api_keys_section() {
    config_mark_scope "api_keys"
    section "Cles API LLM"
    info "Entree = conserver, '-' = vider une cle optionnelle."
    echo ""

    ANTHROPIC_API_KEY=$(input_optional_secret "Anthropic API Key :" "${ANTHROPIC_API_KEY:-}")
    OPENAI_API_KEY=$(input_optional_secret "OpenAI API Key :" "${OPENAI_API_KEY:-}")
    GOOGLE_API_KEY=$(input_optional_secret "Google API Key :" "${GOOGLE_API_KEY:-}")
    MISTRAL_API_KEY=$(input_optional_secret "Mistral API Key :" "${MISTRAL_API_KEY:-}")
    GROQ_API_KEY=$(input_optional_secret "Groq API Key :" "${GROQ_API_KEY:-}")

    echo ""
    echo -e "  ${BOLD}Defaut LLM${NC}"
    DEFAULT_LLM_PROVIDER=$(input_value "Provider (anthropic/openai/google/mistral/groq) :" "${DEFAULT_LLM_PROVIDER:-anthropic}")
    DEFAULT_LLM_MODEL=$(input_value "Modele :" "${DEFAULT_LLM_MODEL:-claude-sonnet-4-20250514}")

    echo ""
    echo -e "  ${BOLD}Authentification API${NC}"
    if [[ -z "${MASCARADE_API_KEY:-}" ]]; then
        if confirm "Generer un token Bearer API ?"; then
            MASCARADE_API_KEY=$(openssl rand -hex 32 2>/dev/null || head -c 64 /dev/urandom | od -An -tx1 | tr -d ' \n')
            ok "Token genere : ${MASCARADE_API_KEY:0:12}..."
        else
            info "Aucun token API configure"
        fi
    else
        ok "Token existant : ${MASCARADE_API_KEY:0:12}..."
        menu_select "Token API :" \
            "Conserver le token actuel" \
            "Regenerer un nouveau token" \
            "Supprimer le token"
        case "$MENU_RESULT" in
            0)
                info "Token conserve"
                ;;
            1)
                MASCARADE_API_KEY=$(openssl rand -hex 32 2>/dev/null || head -c 64 /dev/urandom | od -An -tx1 | tr -d ' \n')
                ok "Nouveau token : ${MASCARADE_API_KEY:0:12}..."
                ;;
            2)
                MASCARADE_API_KEY=""
                warn "Token API supprime"
                ;;
        esac
    fi

    return 0
}

configure_integrations_section() {
    config_mark_scope "integrations"
    section "Integrations"
    info "Entree = conserver, '-' = vider une valeur optionnelle."
    echo ""

    echo -e "  ${BOLD}Notion${NC}"
    NOTION_API_KEY=$(input_optional_secret "Notion API Key (optionnel) :" "${NOTION_API_KEY:-}")

    echo ""
    echo -e "  ${BOLD}ComfyUI${NC}"
    menu_select "Configuration ComfyUI :" \
        "Serveur distant (URL existante)" \
        "Installation locale (Docker)" \
        "Desactiver"
    case "$MENU_RESULT" in
        0)
            COMFYUI_URL=$(input_optional_value "URL du serveur ComfyUI :" "${COMFYUI_URL:-}")
            if [[ -n "$COMFYUI_URL" ]]; then
                COMFYUI_LOCAL=false
            else
                COMFYUI_LOCAL=false
                info "URL vide: ComfyUI sera considere comme desactive"
            fi
            ;;
        1)
            COMFYUI_URL="http://comfyui:8188"
            COMFYUI_LOCAL=true
            info "ComfyUI sera installe en local via Docker"
            ;;
        2)
            COMFYUI_URL=""
            COMFYUI_LOCAL=false
            info "ComfyUI desactive"
            ;;
    esac

    return 0
}

configure_cad_section() {
    config_mark_scope "cad"
    section "CAD / KiCad"
    info "Configurer le dossier plugins KiCad, le workspace CAD et les bundles a installer."
    info "Entree = conserver, '-' = vider une valeur optionnelle."
    echo ""

    KICAD_VERSION=$(input_value "Version KiCad :" "${KICAD_VERSION:-9.0}")
    KICAD_PLUGIN_DIR=$(input_optional_value "Repertoire plugins KiCad (optionnel) :" "${KICAD_PLUGIN_DIR:-}")
    CAD_WORKSPACE_DIR=$(input_optional_value "Workspace CAD (optionnel) :" "${CAD_WORKSPACE_DIR:-}")

    echo ""
    menu_select "Bundles plugins a preparer :" \
        "All plugins (Recommended)" \
        "Fabrication Toolkit only" \
        "KIC-AI only"
    case "$MENU_RESULT" in
        0)
            CAD_INSTALL_BUNDLES="all"
            ;;
        1)
            CAD_INSTALL_BUNDLES="fabrication-toolkit"
            ;;
        2)
            CAD_INSTALL_BUNDLES="kic-ai"
            ;;
    esac

    return 0
}

configure_cluster_section() {
    config_mark_scope "cluster"
    section "Cluster multi-machine"
    info "Le cluster v1 utilise un VPN prive et un Bearer dedie inter-noeuds."
    echo ""

    if [[ "${CLUSTER_ENABLED:-false}" == "true" ]]; then
        if ! confirm "Conserver le mode cluster actif ?"; then
            CLUSTER_ENABLED=false
        fi
    else
        if confirm "Activer le mode cluster ?"; then
            CLUSTER_ENABLED=true
        fi
    fi

    if [[ "${CLUSTER_ENABLED:-false}" == "true" ]]; then
        NODE_ID=$(input_value "Node ID :" "${NODE_ID:-node-1}")
        NODE_ROLE=$(input_value "Role du noeud :" "${NODE_ROLE:-general}")
        NODE_LABEL=$(input_value "Label du noeud :" "${NODE_LABEL:-Mascarade Node 1}")
        MESH_BIND_HOST=$(input_value "IP mesh/VPN du noeud :" "${MESH_BIND_HOST:-}")
        MESH_SCHEME=$(input_value "Scheme mesh (http/https) :" "${MESH_SCHEME:-http}")
        CLUSTER_SHARED_KEY=$(input_optional_secret "Cle Bearer inter-noeuds :" "${CLUSTER_SHARED_KEY:-}")
        CLUSTER_REQUEST_TIMEOUT_MS=$(input_value "Timeout cluster (ms) :" "${CLUSTER_REQUEST_TIMEOUT_MS:-5000}")
        CLUSTER_HEARTBEAT_SECONDS=$(input_value "Heartbeat logique (s) :" "${CLUSTER_HEARTBEAT_SECONDS:-30}")
        if [[ "${CLUSTER_FORWARD_ENABLED:-true}" == "true" ]]; then
            if ! confirm "Conserver le forward `core -> core` actif ?"; then
                CLUSTER_FORWARD_ENABLED=false
            fi
        else
            if confirm "Activer le forward `core -> core` ?"; then
                CLUSTER_FORWARD_ENABLED=true
            fi
        fi
        CLUSTER_PEERS=$(input_optional_value "Peers (peer|role|url;...) :" "${CLUSTER_PEERS:-}")
    else
        NODE_ID="${NODE_ID:-node-1}"
        NODE_ROLE="${NODE_ROLE:-general}"
        NODE_LABEL="${NODE_LABEL:-Mascarade Node 1}"
        MESH_BIND_HOST=""
        MESH_SCHEME="${MESH_SCHEME:-http}"
        CLUSTER_SHARED_KEY=""
        CLUSTER_REQUEST_TIMEOUT_MS="${CLUSTER_REQUEST_TIMEOUT_MS:-5000}"
        CLUSTER_HEARTBEAT_SECONDS="${CLUSTER_HEARTBEAT_SECONDS:-30}"
        CLUSTER_FORWARD_ENABLED=false
        CLUSTER_PEERS=""
    fi

    return 0
}

configure_ports_section() {
    config_mark_scope "ports"
    section "Ports des services"
    info "Entree = conserver la valeur actuelle."
    echo ""

    local var service prompt current
    for var in "${CONFIG_PORT_FIELDS[@]}"; do
        service="${CONFIG_PORT_SERVICE[$var]}"
        svc_selected "$service" || continue
        prompt="${CONFIG_PORT_LABEL[$var]} :"
        current="${!var:-$(config_field_default "$var" "$service")}"
        printf -v "$var" '%s' "$(input_value "$prompt" "$current")"
        if [[ "$var" != "PUBLISH_BIND_HOST" && "$var" != "EDGE_PROXY_BIND_HOST" && "$var" != "EDGE_PROXY_HTTPS_PORT" ]]; then
            SVC_PORT[$service]="${!var}"
        fi
    done

    return 0
}

run_guided_config() {
    step_progress 1 5 "Cles API et defaut LLM"
    configure_api_keys_section
    step_progress 2 5 "Integrations externes"
    configure_integrations_section
    step_progress 3 5 "Cluster multi-machine"
    configure_cluster_section
    step_progress 4 5 "CAD / KiCad"
    configure_cad_section
    step_progress 5 5 "Ports exposes"
    configure_ports_section

    return 0
}

show_llm_summary() {
    local enabled=()
    [[ -n "${ANTHROPIC_API_KEY:-}" ]] && enabled+=("Anthropic")
    [[ -n "${OPENAI_API_KEY:-}" ]] && enabled+=("OpenAI")
    [[ -n "${GOOGLE_API_KEY:-}" ]] && enabled+=("Google")
    [[ -n "${MISTRAL_API_KEY:-}" ]] && enabled+=("Mistral")
    [[ -n "${GROQ_API_KEY:-}" ]] && enabled+=("Groq")

    echo -e "  ${BOLD}LLM${NC}"
    if [[ ${#enabled[@]} -gt 0 ]]; then
        local IFS=', '
        echo -e "    Providers actifs : ${enabled[*]}"
    else
        echo -e "    ${DIM}Aucun provider API configure${NC}"
    fi
    echo -e "    Defaut : ${DEFAULT_LLM_PROVIDER:-anthropic} / ${DEFAULT_LLM_MODEL:-claude-sonnet-4-20250514}"

    local token_state="absent"
    [[ -n "${MASCARADE_API_KEY:-}" ]] && token_state="configure ($(mask_config_value "$MASCARADE_API_KEY"))"
    if value_changed "MASCARADE_API_KEY"; then
        token_state+=" ${DIM}(modifie)${NC}"
    fi
    echo -e "    Bearer API : ${token_state}"

    return 0
}

show_integrations_summary() {
    echo -e "  ${BOLD}Integrations${NC}"

    local notion_state="absent"
    [[ -n "${NOTION_API_KEY:-}" ]] && notion_state="configure ($(mask_config_value "$NOTION_API_KEY"))"
    if value_changed "NOTION_API_KEY"; then
        notion_state+=" ${DIM}(modifie)${NC}"
    fi
    echo -e "    Notion : ${notion_state}"

    local comfy_state="desactive"
    if [[ "${COMFYUI_LOCAL:-false}" == "true" ]]; then
        comfy_state="local via Docker"
    elif [[ -n "${COMFYUI_URL:-}" ]]; then
        comfy_state="distant (${COMFYUI_URL})"
    fi
    if value_changed "COMFYUI_URL" || value_changed "COMFYUI_LOCAL"; then
        comfy_state+=" ${DIM}(modifie)${NC}"
    fi
    echo -e "    ComfyUI : ${comfy_state}"

    return 0
}

show_cluster_summary() {
    echo -e "  ${BOLD}Cluster${NC}"
    if [[ "${CLUSTER_ENABLED:-false}" != "true" ]]; then
        echo -e "    ${DIM}Mode local uniquement${NC}"
        return 0
    fi

    local shared_key_state="absent"
    [[ -n "${CLUSTER_SHARED_KEY:-}" ]] && shared_key_state="$(mask_config_value "$CLUSTER_SHARED_KEY")"
    echo -e "    Node : ${NODE_ID:-node-1} / ${NODE_ROLE:-general}"
    echo -e "    Label : ${NODE_LABEL:-Mascarade Node 1}"
    echo -e "    Mesh : ${MESH_SCHEME:-http}://${MESH_BIND_HOST:-?}:${CORE_PORT:-8100}"
    echo -e "    Bearer cluster : ${shared_key_state}"
    echo -e "    Forward core->core : ${CLUSTER_FORWARD_ENABLED:-false}"
    echo -e "    Peers : ${CLUSTER_PEERS:-aucun}"
    return 0
}

show_cad_summary() {
    echo -e "  ${BOLD}CAD / KiCad${NC}"

    local plugin_dir="${KICAD_PLUGIN_DIR:-}"
    local plugin_note=""
    if [[ -z "$plugin_dir" ]]; then
        plugin_dir="$(config_default_kicad_plugin_dir)"
        plugin_note=" ${DIM}(auto)${NC}"
    fi

    local workspace_dir
    workspace_dir="$(config_effective_cad_workspace_dir)"
    if [[ -z "${CAD_WORKSPACE_DIR:-}" ]]; then
        workspace_dir+=" ${DIM}(repo root)${NC}"
    fi

    echo -e "    KiCad : ${KICAD_VERSION:-9.0}"
    echo -e "    Plugin dir : ${plugin_dir}${plugin_note}"
    echo -e "    Bundles : ${CAD_INSTALL_BUNDLES:-all}"
    echo -e "    Workspace CAD : ${workspace_dir}"
    return 0
}

has_port_changes() {
    local var
    for var in "${CONFIG_PORT_FIELDS[@]}"; do
        if value_changed "$var"; then
            return 0
        fi
    done
    return 1
}

validate_cluster_section() {
    [[ "${CLUSTER_ENABLED:-false}" == "true" ]] || return 0

    local missing=()
    [[ -z "${NODE_ID:-}" ]] && missing+=("NODE_ID")
    [[ -z "${NODE_ROLE:-}" ]] && missing+=("NODE_ROLE")
    [[ -z "${MESH_BIND_HOST:-}" ]] && missing+=("MESH_BIND_HOST")
    [[ -z "${CLUSTER_SHARED_KEY:-}" ]] && missing+=("CLUSTER_SHARED_KEY")
    if [[ ${#missing[@]} -gt 0 ]]; then
        err "Configuration cluster incomplete: ${missing[*]}"
        return 1
    fi

    local peer
    IFS=';' read -ra peer_list <<< "${CLUSTER_PEERS:-}"
    for peer in "${peer_list[@]}"; do
        [[ -z "${peer// }" ]] && continue
        IFS='|' read -ra fields <<< "$peer"
        if [[ ${#fields[@]} -ne 3 ]]; then
            err "Entree CLUSTER_PEERS invalide: $peer"
            info "Format attendu: peer-id|role|http://ip:8100;peer2|role|http://ip:8100"
            return 1
        fi
    done

    return 0
}

validate_cad_section() {
    local version="${KICAD_VERSION:-}"
    local bundles="${CAD_INSTALL_BUNDLES:-all}"

    if [[ -z "$version" ]]; then
        err "Configuration CAD incomplete: KICAD_VERSION est vide"
        return 1
    fi

    case "$bundles" in
        all|fabrication-toolkit|kic-ai)
            ;;
        *)
            err "CAD_INSTALL_BUNDLES invalide: $bundles"
            info "Valeurs attendues: all | fabrication-toolkit | kic-ai"
            return 1
            ;;
    esac

    return 0
}

show_ports_summary() {
    echo -e "  ${BOLD}Ports${NC}"
    local changed=0 var service before after
    for var in "${CONFIG_PORT_FIELDS[@]}"; do
        service="${CONFIG_PORT_SERVICE[$var]}"
        svc_selected "$service" || continue
        before="${CONFIG_ORIG[$var]:-$(config_field_default "$var" "$service")}"
        after="${!var:-}"
        if [[ "$before" != "$after" ]]; then
            echo -e "    ${CONFIG_PORT_LABEL[$var]} : ${before:-non defini} -> ${after:-non defini}"
            changed=1
        fi
    done

    if [[ $changed -eq 0 ]]; then
        echo -e "    ${DIM}Aucun port modifie${NC}"
    fi

    return 0
}

show_config_summary() {
    local changed_keys_count="$1"
    local show_ports=0

    echo ""
    section "Recapitulatif"
    echo -e "  ${BOLD}Mode :${NC} ${CONFIG_SCOPE_LABEL}"
    echo -e "  ${BOLD}Services actifs :${NC} ${#ACTIVE_SERVICE_IDS[@]}"
    echo -e "  ${BOLD}Variables modifiees :${NC} ${changed_keys_count}"
    echo ""

    if [[ "${CONFIG_SCOPE_TOUCHED[api_keys]:-0}" == "1" || "$CONFIG_SCOPE_LABEL" == "Configuration complete" ]]; then
        show_llm_summary
        echo ""
    fi
    if [[ "${CONFIG_SCOPE_TOUCHED[integrations]:-0}" == "1" || "$CONFIG_SCOPE_LABEL" == "Configuration complete" ]]; then
        show_integrations_summary
        echo ""
    fi
    if [[ "${CONFIG_SCOPE_TOUCHED[cluster]:-0}" == "1" || "$CONFIG_SCOPE_LABEL" == "Configuration complete" ]]; then
        show_cluster_summary
        echo ""
    fi
    if [[ "${CONFIG_SCOPE_TOUCHED[cad]:-0}" == "1" || "$CONFIG_SCOPE_LABEL" == "Configuration complete" ]]; then
        show_cad_summary
        echo ""
    fi
    if [[ "${CONFIG_SCOPE_TOUCHED[ports]:-0}" == "1" || "$CONFIG_SCOPE_LABEL" == "Configuration complete" ]]; then
        show_ports=1
    elif has_port_changes; then
        show_ports=1
    fi

    if [[ $show_ports -eq 1 ]]; then
        show_ports_summary
    fi

    return 0
}

# ═══════════════════════════════════════
# Flow principal
# ═══════════════════════════════════════

banner

echo -e "  ${BOLD}Reconfiguration Mascarade${NC}"
echo -e "  ${DIM}Modifier la configuration sans tout reinstaller${NC}"

# ── Charger l'etat actuel ──
env_file="$REPO_DIR/.env"

if [[ ! -f "$env_file" ]]; then
    err "Pas de fichier .env trouve. Lance d'abord ./setup"
    dbg "  fichier absent: $env_file"
    exit 1
fi

dbg "Chargement $env_file ($(wc -l < "$env_file") lignes)..."
load_env "$env_file"
ok "Configuration actuelle chargee"
sync_service_ports_from_env
capture_config_snapshot

# Detecter les services actifs
dbg "Detection des services actifs depuis docker-compose.yml..."
if load_running_services 2>/dev/null; then
    ok "Services detectes depuis docker-compose.yml"
else
    dbg "Pas de docker-compose.yml ou docker absent — fallback: tout actif"
    for id in "${SVC_IDS[@]}"; do SVC_ON[$id]="1"; done
fi
sync_service_ports_from_env
collect_active_service_ids
show_active_stack_overview

# ── Menu principal ──
echo ""
menu_select "Que voulez-vous reconfigurer ?" \
    "Assistant guide — cles API, integrations, cluster, CAD, ports" \
    "Cles API LLM + defaut" \
    "Integrations (Notion, ComfyUI)" \
    "Cluster multi-machine" \
    "CAD / KiCad" \
    "Ports des services actifs" \
    "Tout reconfigurer"

config_choice=$MENU_RESULT
dbg "Choix config: $config_choice"
CONFIG_SCOPE_LABEL=""

case $config_choice in
    0)
        CONFIG_SCOPE_LABEL="Assistant guide"
        run_guided_config
        ;;
    1)
        CONFIG_SCOPE_LABEL="Cles API LLM"
        configure_api_keys_section
        ;;
    2)
        CONFIG_SCOPE_LABEL="Integrations"
        configure_integrations_section
        ;;
    3)
        CONFIG_SCOPE_LABEL="Cluster multi-machine"
        configure_cluster_section
        ;;
    4)
        CONFIG_SCOPE_LABEL="CAD / KiCad"
        configure_cad_section
        ;;
    5)
        CONFIG_SCOPE_LABEL="Ports des services"
        configure_ports_section
        ;;
    6)
        CONFIG_SCOPE_LABEL="Configuration complete"
        config_mark_scope "api_keys"
        config_mark_scope "integrations"
        config_mark_scope "cluster"
        config_mark_scope "cad"
        config_mark_scope "ports"
        section "Configuration complete"
        for mod_file in "$REPO_DIR/scripts/modules/"*.sh; do
            dbg "  source $(basename "$mod_file")"
            # shellcheck disable=SC1090
            source "$mod_file"
        done
        collect_module_configs
        sync_service_ports_from_env
        configure_cad_section
        ;;
esac

# ── Preview des modifications ──
echo ""
section "Preparation du diff"

validate_cluster_section || exit 2
validate_cad_section || exit 2

dbg "Ecriture .env temporaire pour diff..."
tmp_dir=$(mktemp -d)
tmp_env="$tmp_dir/.env"
write_env_file "$tmp_env" >/dev/null 2>&1

diff_output=$(diff --color=auto -u0 -I '^# \\.env .*Genere par Mascarade setup' "$env_file" "$tmp_env" 2>/dev/null || true)
if [[ -z "$diff_output" ]]; then
    ok "Aucune modification detectee"
    rm -rf "$tmp_dir"
    dbg "  fichiers identiques"
    exit 0
fi

changed_keys_count=$(printf '%s\n' "$diff_output" | grep -E '^[+-][A-Z0-9_]+=' | sed -E 's/^[+-]//' | cut -d= -f1 | sort -u | wc -l | tr -d ' ' || true)
show_config_summary "$changed_keys_count"

echo ""
section "Apercu des modifications"
echo "$diff_output"

echo ""
if ! confirm "Appliquer ces modifications ?"; then
    rm -rf "$tmp_dir"
    ok "Modifications annulees"
    dbg "Modifications annulees par l'utilisateur"
    exit 0
fi

# ── Ecriture ──
dbg "Application des modifications..."
backup_file "$env_file"
mv "$tmp_env" "$env_file"
rmdir "$tmp_dir" 2>/dev/null || true
chmod 600 "$env_file"
dbg ".env mis a jour: $(wc -l < "$env_file") lignes, permissions $(stat -c '%a' "$env_file" 2>/dev/null || echo '?')"
ok ".env mis a jour ($(wc -l < "$env_file") lignes, permissions 600)"

# ── Regenerer docker-compose.yml si ports modifies ──
if has_port_changes; then
    echo ""
    if confirm "Regenerer docker-compose.yml avec les nouveaux ports ?"; then
        dbg "Regeneration docker-compose.yml..."
        backup_file "$REPO_DIR/docker-compose.yml"
        generate_compose "$REPO_DIR/docker-compose.yml"
        dbg "  genere: $(wc -l < "$REPO_DIR/docker-compose.yml") lignes"
        ok "docker-compose.yml regenere"
    else
        dbg "Regeneration docker-compose.yml refusee"
    fi
fi

# ── Restart optionnel ──
echo ""
if confirm "Redemarrer les services impactes ?"; then
    dbg "Restart des services..."
    spin_start "Restart des services..."
    restart_rc=0
    docker_compose_cmd -f "$REPO_DIR/docker-compose.yml" up -d 2>&1 || restart_rc=$?
    spin_stop
    if [[ $restart_rc -eq 0 ]]; then
        ok "Services redemarres"
    else
        warn "Restart partiel (code $restart_rc)"
    fi
    dbg "  restart rc=$restart_rc"

    dbg "Attente 3s avant status..."
    sleep 3
    invalidate_docker_cache
    show_status_table
else
    dbg "Restart refuse par l'utilisateur"
fi

echo ""
line
echo -e "  ${DIM}mascarade v0.1.0${NC}"
dbg "=== config termine === duree=$(ps -o etime= -p $$ 2>/dev/null || echo '?')"
echo ""
