# Copy to .env.local, then fill sensitive values.
# cp .env.example.project .env.local

# VM
ESXI_HOST=192.168.0.10
ESXI_USERNAME=root
ESXI_PASSWORD=***REDACTED***
GOVC_INSECURE=true
VM_NAME=photon-docker
VM_ROOT_USER=root
VM_ROOT_PASSWORD=***REDACTED***
VM_IP=192.168.0.119
TZ=Europe/Paris

# Stack
STACK_DIR=/opt/docker-studio-ai/tools/dev/docker-studio-ai
LLM_URL=http://ollama:11434/v1/chat/completions
LLM_MODEL=qwen2.5-coder:0.5b
OLLAMA_HOST_PORT=11434
GATEWAY_HOST_PORT=8787
OPEN_WEBUI_HOST_PORT=3000
QDRANT_HOST_PORT=6333
HEALTH_TIMEOUT=5
OLLAMA_BIND_IP=127.0.0.1
GATEWAY_BIND_IP=127.0.0.1
ZEROCLAW_BIND_IP=0.0.0.0
DISCORD_MCP_BIND_IP=127.0.0.1
CONTINUE_BIND_IP=127.0.0.1
CONTINUE_PORT=65432

# Ops console (root web UI)
OPS_CONSOLE_PORT=80
OPS_CONSOLE_TOKEN=***REDACTED***
OPS_POLL_TIMEOUT_MS=4000
OPS_MANAGED_CONTAINERS=zacus-ollama,zacus-studio-ai-gateway,zacus-open-webui,zacus-redis,zacus-qdrant,zacus-postgres,zacus-pihole,zacus-homeassistant,zacus-zeroclaw,zacus-discord-mcp-lite,zacus-continue-ai,zacus-pinchtab,ops-console

# Devtools profiles
PIO_PROJECTS_ROOT=/opt/projects/pio
WEB_PROJECTS_ROOT=/opt/projects/web
WEB_DEV_PORT=5173
WEB_PREVIEW_PORT=4173
WEB_NEXT_PORT=3001

# Pi-hole
PIHOLE_DNS_PORT=53
PIHOLE_WEB_PORT=8081
PIHOLE_PASSWORD=***REDACTED***
PIHOLE_UPSTREAM_DNS1=1.1.1.1
PIHOLE_UPSTREAM_DNS2=8.8.8.8

# Database (required by docker-compose.extra.yml)
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=***REDACTED***

QDRANT_BIND_IP=127.0.0.1
