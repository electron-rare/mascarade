    dbg "Compose profiles mode active: mapping services to profiles"

    # Map selected services to their profiles
    declare -A profile_set=()
    for id in "${SVC_IDS[@]}"; do
        if [[ "${SVC_ON[$id]}" == "1" ]]; then
            local svc_profile="${SVC_PROFILES[$id]:-}"
            if [[ -n "$svc_profile" ]]; then
                profile_set["$svc_profile"]=1
                dbg "  Service $id → profile $svc_profile"
            fi
        fi
    done

    # Build COMPOSE_PROFILES from selected profiles (if not explicitly set)
    if [[ -z "$COMPOSE_PROFILES" ]]; then
        local -a profile_list=()
        for profile in "${!profile_set[@]}"; do
            profile_list+=("$profile")
        done
        # Sort for deterministic output
        IFS=$'\n' sorted_profiles=($(sort <<<"${profile_list[*]}"))
        unset IFS
        COMPOSE_PROFILES=$(IFS=,; echo "${sorted_profiles[*]}")
        dbg "Auto-detected COMPOSE_PROFILES: $COMPOSE_PROFILES"
    fi

    # Enable ALL services for generation (profile tags in YAML will filter at runtime)
    local all_services_count=0
    for id in "${SVC_IDS[@]}"; do
        SVC_ON[$id]="1"
        ((all_services_count++)) || true
    done

    info "Profils Docker Compose: $COMPOSE_PROFILES"
    info "Generation complete avec ${all_services_count} services (filtres par profils au demarrage)"
    dbg "Tous les services actives pour generation docker-compose.yml complet"
fi

if [[ "$SMOKE_GENERATE_AUDIO" == true && "${SVC_ON[generate-audio]:-0}" != "1" ]]; then
