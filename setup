#!/usr/bin/env bash
# setup — Installateur principal Mascarade
# Usage : ./setup [options]

# Si lance via sh/dash, relancer proprement avec bash.
if [ -z "${BASH_VERSION:-}" ]; then
    exec bash "$0" "$@"
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

AUTO_CONFIRM=false
NO_START=false
SKIP_DEPS=false
SKIP_TESTS=false
ROLLBACK_ON_FAIL=false
WITH_SERVICES_RAW=""
PRESELECT_MODE=false
INSTALL_REPO_SKILLS=false
INSTALL_REPO_LLMS=false
INSTALL_REPO_ASSETS_ONLY=false
RESTORE_LAST=false
SKILLS_DEST=""
OLLAMA_MODELS_RAW=""
OLLAMA_PACK="balanced"
PROFILE_MODE=""
PROFILE_EFFECTIVE=""
COMPOSE_PROFILES=""
COMPOSE_PROFILES_MODE=true  # Default: use Docker Compose native profiles
OPS_CONSOLE_ONLY=false
FORCE_CLEAN=false
SMOKE_GENERATE_AUDIO=false
ENABLE_CLUSTER=false
RUN_CAD_PLUGINS=false
RUN_CAD_DOCTOR=false
RUN_CAD_STACK=false
RUN_CAD_SMOKE=false
CAD_PLUGINS_EXPLICIT=false
CAD_DOCTOR_EXPLICIT=false
CAD_STACK_EXPLICIT=false
CAD_SMOKE_EXPLICIT=false

# Initialisation - ORDRE CORRIGÉ
source "$SCRIPT_DIR/scripts/lib.sh"
source "$SCRIPT_DIR/scripts/services.sh"
source "$SCRIPT_DIR/scripts/prereqs.sh"
source "$SCRIPT_DIR/scripts/compose.sh"

# Maintenant les fonctions sont disponibles
setup_trap

SETUP_SNAPSHOT_PATH=""
SETUP_ROLLBACK_DONE=false

safe_mktemp_file() {
    local prefix="$1"
    local template
    template="${prefix}.tmp.XXXXXX"

    local -a candidates=(
        "${TMPDIR:-}"
        "$REPO_DIR/.tmp"
        "$REPO_DIR/tmp"
        "/tmp"
        "/var/tmp"
        "$HOME"
    )

    local dir tmp
    for dir in "${candidates[@]}"; do
        [[ -z "$dir" ]] && continue
        if mkdir -p "$dir" 2>/dev/null && [[ -w "$dir" ]]; then
            tmp="$(mktemp "$dir/$template" 2>/dev/null || true)"
            if [[ -n "$tmp" ]]; then
                echo "$tmp"
                return 0
            fi
        fi
    done

    return 1
}

safe_mktemp_write_target() {
    local path
    path=$(safe_mktemp_file "mascarade-setup")
    if [[ -z "$path" ]]; then
        err "Echec creation fichier temporaire: espace disque ou droits insuffisants."
        warn "Verification: "
        local target
        for target in "${TMPDIR:-$HOME}" "/tmp" "/var/tmp" "$REPO_DIR/.tmp"; do
            echo "  $target : $(df -h "$target" 2>/dev/null | awk 'NR==2 {print $4}')"
        done
        return 1
    fi
    echo "$path"
    return 0
}

declare -a OLLAMA_PACK_LITE=(
    "tinyllama"
    "qwen2.5:0.5b"
    "qwen2.5-coder:0.5b"
    "phi3:mini"
    "llama3.2:1b"
)

declare -a OLLAMA_PACK_BALANCED=(
    # Pack adapte a ~7 GiB RAM sans GPU
    "llama3.2:1b"
    "llama3.2:3b"
    "qwen2.5:0.5b"
    "qwen2.5:1.5b"
    "qwen2.5-coder:0.5b"
    "qwen2.5-coder:1.5b"
    "gemma2:2b"
    "phi3:mini"
    "tinyllama"
)

declare -a OLLAMA_PACK_HEAVY=(
    # Pack necessitant plus de RAM et idealement un GPU
    "llama3.2:3b"
    "qwen2.5:3b"
    "qwen2.5-coder:3b"
    "qwen2.5:7b"
    "qwen2.5-coder:7b"
    "mistral:7b"
    "gemma2:9b"
)

show_setup_help() {
    cat <<'HELP'
Usage: ./setup [options]

Installateur TUI Mascarade. Selectionne les services, configure .env,
genere docker-compose.yml avec profils Docker Compose et peut demarrer la stack.

PAR DEFAUT: Le setup genere un docker-compose.yml complet avec tous les services
tagges par profils (core, observability, industrial, personal, fine-tuning).
Utilisez --profile pour selectionner quels profils demarrer.

Options:
  -h, --help                 Afficher cette aide et quitter
  -v, --verbose              Afficher les traces de debug
  -y, --yes                  Repondre "oui" aux confirmations
      --with <ids>           Preselection services (csv), ex: core,api,redis
      --profile <name>       Profil services: minimal|standard|full|apple-silicon|auto
                             (Traduit en profils Docker Compose: core,observability,etc)
      --all                  Alias de --profile full (active tous les profils)
      --compose-profiles <p> Profils Docker Compose explicites (csv), ex: core,observability
      --legacy-generation    Utiliser l'ancienne generation conditionnelle (deprecated)
      --no-start             Ne pas lancer docker compose up a la fin
      --skip-deps            Ne pas installer les dependances Python/Node locales
      --skip-tests           Ne pas lancer les tests Python pendant le setup
      --install-repo-skills  Installer tous les skills proposes dans ./skills
      --install-repo-llms    Telecharger les modeles Ollama proposes par le repo
      --install-repo-assets  Equivaut a --install-repo-skills + --install-repo-llms
      --install-repo-assets-only  Installer uniquement skills + LLM, sans setup complet
      --skills-dest <path>   Dossier cible skills (defaut: ~/.codex/skills/mascarade)
      --ollama-pack <name>   Pack LLM: lite|balanced|heavy (defaut: balanced)
      --ollama-models <csv>  Liste de modeles Ollama a pull (prioritaire sur --ollama-pack)
      --ops-console-only     Alias legacy: lance core+api+edge-proxy pour servir /ops puis quitte
      --cluster              Active la configuration multi-machine privee pour le core
      --p2p                  Alias de --cluster (mode P2P multi-machine)
      --cad-plugins         Installe les plugins KiCad configures dans le .env
      --cad-doctor          Verifie les plugins KiCad configures apres installation
      --cad-stack           Demarre la stack CAD/KiCad dediee apres le setup principal
      --cad-smoke           Lance le smoke test CAD complet (doctor + MCP + plugins)
      --smoke-generate-audio  Lance un vrai POST /generate apres demarrage (opt-in)
      --force-clean          Nettoyage complet avant installation
      --restore-last         Restaurer le dernier snapshot config puis quitter
      --rollback-on-fail     Restauration automatique du dernier snapshot en cas d'erreur

Packs Ollama (indicatif):
  lite      CPU: 2-4 vCPU | RAM: 4-6 GiB     | GPU: non requis (0-4 GiB VRAM)
  balanced  CPU: 4-8 vCPU | RAM: 6-10 GiB    | GPU: optionnel (4-8 GiB VRAM)
  heavy     CPU: 8+ vCPU  | RAM: 12-24+ GiB  | GPU: recommande (8-16+ GiB VRAM)

Profils:
  apple-silicon  macOS Apple Silicon (M1-M5), stack legere et Ollama natif si disponible

Services disponibles:
  core, api, litellm, n8n, langfuse, firecrawl, mem0, dify, clickhouse, comfyui, tts, stt, generate-audio (AudioCraft CPU/GPU),
  ollama, edge-proxy, ops-agent, redis, postgres, qdrant, grafana, prometheus, loki, promtail, otel-collector
HELP
}

# Resource validation
check_resources() {
    local total_ram=""
    local total_cpu=""

    total_ram=$(system_total_ram_gib 2>/dev/null || true)
    total_cpu=$(system_cpu_count 2>/dev/null || true)

    if [[ -n "$total_ram" && "$total_ram" =~ ^[0-9]+$ ]] && [[ "$total_ram" -lt 8 ]] && [[ "$OLLAMA_PACK" != "lite" ]]; then
        warn "Low memory detected ($total_ram GB). Consider using --ollama-pack lite"
        if [[ "$AUTO_CONFIRM" == false ]]; then
            confirm "Continue anyway?" || exit 1
        fi
    fi

    if [[ -n "$total_cpu" && "$total_cpu" =~ ^[0-9]+$ ]] && [[ "$total_cpu" -lt 4 ]]; then
        warn "Low CPU cores detected ($total_cpu). Performance may be impacted"
    fi

    if is_apple_silicon; then
        info "Apple Silicon detecte — profil apple-silicon recommande pour Ollama natif / MLX / Core ML."
    fi
}

# Convert comma-separated profile list to Docker Compose --profile flags
profile_to_compose_args() {
    local profiles_csv="$1"
    local -a profiles_array
    local result=""

    # Return empty if no profiles provided
    [[ -z "$profiles_csv" ]] && return 0

    # Split CSV into array
    IFS=',' read -ra profiles_array <<< "$profiles_csv"

    # Build --profile flags
    for profile in "${profiles_array[@]}"; do
        # Trim whitespace
        profile=$(echo "$profile" | xargs)
        [[ -z "$profile" ]] && continue
        result="${result}--profile ${profile} "
    done

    # Trim trailing space and output
    echo "${result% }"
}

parse_setup_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_setup_help
                exit 0
                ;;
            -v|--verbose)
                VERBOSE=true
                ;;
            -y|--yes)
                AUTO_CONFIRM=true
                ;;
            --with)
                if [[ $# -lt 2 || -z "${2:-}" ]]; then
                    err "Option --with attend une liste de services (csv)."
                    exit 2
                fi
                WITH_SERVICES_RAW="$2"
                PRESELECT_MODE=true
                shift
                ;;
            --profile)
                if [[ $# -lt 2 || -z "${2:-}" ]]; then
                    err "Option --profile attend: minimal|standard|full|apple-silicon|auto"
                    exit 2
                fi
                PROFILE_MODE="$2"
                shift
                ;;
            --all)
                PROFILE_MODE="full"
                ;;
            --compose-profiles)
                if [[ $# -lt 2 || -z "${2:-}" ]]; then
                    err "Option --compose-profiles attend une liste de profils (csv)."
                    exit 2
                fi
                COMPOSE_PROFILES="$2"
                shift
                ;;
            --legacy-generation)
                COMPOSE_PROFILES_MODE=false
                info "Mode legacy: generation conditionnelle (deprecated)"
                ;;
            --no-start)
                NO_START=true
                ;;
            --skip-deps)
                SKIP_DEPS=true
                ;;
            --skip-tests)
                SKIP_TESTS=true
                ;;
            --install-repo-skills)
                INSTALL_REPO_SKILLS=true
                ;;
            --install-repo-llms)
                INSTALL_REPO_LLMS=true
                ;;
            --install-repo-assets)
                INSTALL_REPO_SKILLS=true
                INSTALL_REPO_LLMS=true
                ;;
            --install-repo-assets-only)
                INSTALL_REPO_ASSETS_ONLY=true
                INSTALL_REPO_SKILLS=true
                INSTALL_REPO_LLMS=true
                ;;
            --skills-dest)
                if [[ $# -lt 2 || -z "${2:-}" ]]; then
                    err "Option --skills-dest attend un chemin."
                    exit 2
                fi
                SKILLS_DEST="$2"
                shift
                ;;
            --ollama-pack)
                if [[ $# -lt 2 || -z "${2:-}" ]]; then
                    err "Option --ollama-pack attend: lite|balanced|heavy"
                    exit 2
                fi
                OLLAMA_PACK="$2"
                INSTALL_REPO_LLMS=true
                shift
                ;;
            --ollama-models)
                if [[ $# -lt 2 || -z "${2:-}" ]]; then
                    err "Option --ollama-models attend une liste CSV."
                    exit 2
                fi
                OLLAMA_MODELS_RAW="$2"
                INSTALL_REPO_LLMS=true
                shift
                ;;
            --ops-console-only)
                OPS_CONSOLE_ONLY=true
                ;;
            --cluster)
                ENABLE_CLUSTER=true
                CLUSTER_ENABLED=true
                ;;
            --p2p)
                ENABLE_CLUSTER=true
                CLUSTER_ENABLED=true
                ;;
            --cad-plugins)
                RUN_CAD_PLUGINS=true
                CAD_PLUGINS_EXPLICIT=true
                ;;
            --cad-doctor)
                RUN_CAD_DOCTOR=true
                CAD_DOCTOR_EXPLICIT=true
                ;;
            --cad-stack)
                RUN_CAD_STACK=true
                CAD_STACK_EXPLICIT=true
                ;;
            --cad-smoke)
                RUN_CAD_SMOKE=true
                CAD_SMOKE_EXPLICIT=true
                ;;
            --smoke-generate-audio)
                SMOKE_GENERATE_AUDIO=true
                ;;
            --force-clean)
                FORCE_CLEAN=true
                ;;
            --restore-last)
                RESTORE_LAST=true
                ;;
            --rollback-on-fail)
                ROLLBACK_ON_FAIL=true
                ;;
            *)
                err "Option inconnue: $1"
                echo "Utilise: ./setup --help"
                exit 2
                ;;
        esac
        shift
    done

    # Validation croisée des options
    if [[ "$INSTALL_REPO_ASSETS_ONLY" == true ]]; then
        if [[ "$WITH_SERVICES_RAW" != "" || "$PROFILE_MODE" != "" ]]; then
            err "--install-repo-assets-only est incompatible avec --with/--profile"
            exit 2
        fi
    fi

    case "$OLLAMA_PACK" in
        lite|balanced|heavy) ;;
        *)
            err "Pack Ollama invalide: '$OLLAMA_PACK'"
            echo "Valeurs attendues: lite|balanced|heavy"
            exit 2
            ;;
    esac

    if [[ -n "$WITH_SERVICES_RAW" && -n "$PROFILE_MODE" ]]; then
        err "Options incompatibles: --with et --profile/--all"
        echo "Utilise soit --with <csv>, soit --profile <name>"
        exit 2
    fi

    case "${PROFILE_MODE:-}" in
        ""|minimal|standard|full|apple-silicon|auto) ;;
        *)
            err "Profil invalide: '$PROFILE_MODE'"
            echo "Valeurs attendues: minimal|standard|full|apple-silicon|auto"
            exit 2
            ;;
    esac
}

validate_cluster_config() {
    [[ "${CLUSTER_ENABLED:-false}" == "true" ]] || return 0

    local cluster_mesh_host cluster_shared_key
    cluster_mesh_host="${MESH_BIND_HOST:-}"
    cluster_shared_key="${CLUSTER_SHARED_KEY:-}"

    cluster_mesh_host="$(printf '%s' "$cluster_mesh_host" | sed -E 's/^[[:space:]]+|[[:space:]]+$//g')"
    cluster_shared_key="$(printf '%s' "$cluster_shared_key" | sed -E 's/^[[:space:]]+|[[:space:]]+$//g')"

    MESH_BIND_HOST="$cluster_mesh_host"
    CLUSTER_SHARED_KEY="$cluster_shared_key"

    if [[ "${SVC_ON[core]:-0}" != "1" ]]; then
        err "Le mode cluster requiert le service core."
        exit 2
    fi

    local missing=()
    [[ -z "${NODE_ID:-}" ]] && missing+=("NODE_ID")
    [[ -z "${NODE_ROLE:-}" ]] && missing+=("NODE_ROLE")
    [[ -z "${MESH_BIND_HOST}" ]] && missing+=("MESH_BIND_HOST")
    [[ -z "${CLUSTER_SHARED_KEY}" ]] && missing+=("CLUSTER_SHARED_KEY")

    local mdns_ttl="${CLUSTER_MDNS_DISCOVERY_TTL_SECONDS:-60}"
    if ! [[ "$mdns_ttl" =~ ^[0-9]+$ ]] || [[ "$mdns_ttl" -lt 5 ]]; then
        missing+=("CLUSTER_MDNS_DISCOVERY_TTL_SECONDS")
    fi

    local mdns_ttl="${CLUSTER_MDNS_DISCOVERY_TTL_SECONDS:-60}"
    if ! [[ "$mdns_ttl" =~ ^[0-9]+$ ]] || [[ "$mdns_ttl" -lt 5 ]]; then
        missing+=("CLUSTER_MDNS_DISCOVERY_TTL_SECONDS")
    fi

    if [[ ${#missing[@]} -gt 0 ]]; then
        err "Configuration cluster incomplete: ${missing[*]}"
        if [[ "${AUTO_CONFIRM}" != true ]] && _has_input_tty && [[ "${SVC_ON[core]:-0}" == "1" ]]; then
            info "Je relance l'assistant P2P pour remplir les champs manquants."
            if prompt_p2p_setup; then
                if [[ -n "${MESH_BIND_HOST}" && -n "${CLUSTER_SHARED_KEY}" ]]; then
                    return 0
                fi
            fi
        fi
        info "Renseigne ces variables via ./setup --p2p/--cluster, ./config ou la TUI setup."
        exit 2
    fi

    local peer
    IFS=';' read -ra peer_list <<< "${CLUSTER_PEERS:-}"
    for peer in "${peer_list[@]}"; do
        [[ -z "${peer// }" ]] && continue
        IFS='|' read -ra fields <<< "$peer"
        if [[ ${#fields[@]} -ne 3 ]]; then
            err "Entree CLUSTER_PEERS invalide: $peer"
            info "Format attendu: peer-id|role|http://ip:8100;peer2|role|http://ip:8100"
            exit 2
        fi
    done
}

cad_selected_bundles() {
    local bundles="${CAD_INSTALL_BUNDLES:-all}"
    case "$bundles" in
        ""|all|fabrication-toolkit|kic-ai)
            echo "${bundles:-all}"
            return 0
            ;;
        *)
            err "CAD_INSTALL_BUNDLES invalide: $bundles"
            info "Valeurs attendues: all | fabrication-toolkit | kic-ai"
            return 1
            ;;
    esac
}

resolve_kicad_version() {
    if [[ -n "${KICAD_VERSION:-}" ]]; then
        printf '%s\n' "$KICAD_VERSION"
        return 0
    fi

    printf '10.0\n'
}

normalize_kicad_defaults() {
    if [[ "${KICAD_VERSION:-}" == "9.0" ]]; then
        KICAD_VERSION="10.0"
    fi
    if [[ "${KICAD_IMAGE_TAG:-}" == "9.0" ]]; then
        KICAD_IMAGE_TAG="10.0"
    fi

    if [[ -z "${KICAD_VERSION:-}" ]]; then
        KICAD_VERSION="$(resolve_kicad_version)"
    fi
    if [[ -z "${KICAD_IMAGE_TAG:-}" ]]; then
        KICAD_IMAGE_TAG="${KICAD_VERSION:-$(resolve_kicad_version)}"
    fi
}

run_cad_plugins_action() {
    local strict="${1:-false}"
    local bundles
    bundles=$(cad_selected_bundles) || {
        [[ "$strict" == true ]] && return 1
        warn "Configuration CAD invalide, installation plugins ignoree"
        return 1
    }

    local cmd=("$REPO_DIR/scripts/install_kicad_plugins.sh" install "$bundles" --yes)
    [[ -n "${KICAD_PLUGIN_DIR:-}" ]] && cmd+=(--plugin-dir "$KICAD_PLUGIN_DIR")

    log "Installation plugins KiCad (${bundles})..."
    local kicad_version
    kicad_version="$(resolve_kicad_version)"

    if KICAD_VERSION="$kicad_version" "${cmd[@]}"; then
        ok "Plugins KiCad installes"
        return 0
    fi

    if [[ "$strict" == true ]]; then
        err "Installation plugins KiCad echouee"
        return 1
    fi
    warn "Installation plugins KiCad echouee"
    return 1
}

run_cad_doctor_action() {
    local strict="${1:-false}"
    local bundles
    bundles=$(cad_selected_bundles) || {
        [[ "$strict" == true ]] && return 1
        warn "Configuration CAD invalide, doctor ignore"
        return 1
    }

    local cmd=("$REPO_DIR/scripts/install_kicad_plugins.sh" doctor "$bundles")
    [[ -n "${KICAD_PLUGIN_DIR:-}" ]] && cmd+=(--plugin-dir "$KICAD_PLUGIN_DIR")

    log "Verification plugins KiCad (${bundles})..."
    local kicad_version
    kicad_version="$(resolve_kicad_version)"

    if KICAD_VERSION="$kicad_version" "${cmd[@]}"; then
        ok "Doctor KiCad OK"
        return 0
    fi

    if [[ "$strict" == true ]]; then
        err "Doctor KiCad echoue"
        return 1
    fi
    warn "Doctor KiCad echoue"
    return 1
}

run_cad_stack_action() {
    local strict="${1:-false}"
    local kicad_version
    kicad_version="${KICAD_IMAGE_TAG:-$(resolve_kicad_version)}"

    local cmd=("$REPO_DIR/scripts/cad_stack.sh" up)

    log "Demarrage stack CAD/KiCad..."
    if [[ -n "${CAD_WORKSPACE_DIR:-}" ]]; then
        if KICAD_IMAGE_TAG="$kicad_version" CAD_WORKSPACE_DIR="$CAD_WORKSPACE_DIR" "${cmd[@]}"; then
            ok "Stack CAD demarree"
            return 0
        fi
    else
        if KICAD_IMAGE_TAG="$kicad_version" "${cmd[@]}"; then
            ok "Stack CAD demarree"
            return 0
        fi
    fi

    if [[ "$strict" == true ]]; then
        err "Demarrage stack CAD echoue"
        return 1
    fi
    warn "Demarrage stack CAD echoue"
    return 1
}

run_cad_smoke_action() {
    local strict="${1:-false}"

    log "Smoke test CAD..."
    if "$REPO_DIR/scripts/cad_stack.sh" smoke; then
        ok "Smoke test CAD OK"
        return 0
    fi

    if [[ "$strict" == true ]]; then
        err "Smoke test CAD echoue"
        return 1
    fi
    warn "Smoke test CAD echoue"
    return 1
}

prompt_p2p_setup() {
    if [[ "${AUTO_CONFIRM}" == true ]]; then
        return 0
    fi
    if [[ "${SVC_ON[core]:-0}" != "1" ]]; then
        return 0
    fi
    if ! _has_input_tty; then
        return 0
    fi

    if [[ "${CLUSTER_ENABLED:-false}" == "true" ]]; then
        if ! confirm "P2P (cluster) actif. Conserver le mode P2P ?"; then
            CLUSTER_ENABLED=false
            NODE_ID="${NODE_ID:-node-1}"
            NODE_ROLE="${NODE_ROLE:-general}"
            NODE_LABEL="${NODE_LABEL:-Mascarade Node 1}"
            MESH_BIND_HOST=""
            MESH_SCHEME="${MESH_SCHEME:-http}"
            CLUSTER_SHARED_KEY=""
            CLUSTER_REQUEST_TIMEOUT_MS="${CLUSTER_REQUEST_TIMEOUT_MS:-5000}"
            CLUSTER_HEARTBEAT_SECONDS="${CLUSTER_HEARTBEAT_SECONDS:-30}"
            CLUSTER_FORWARD_ENABLED=false
            CLUSTER_PEERS=""
            info "Mode P2P desactive."
            return 0
        fi
    else
        if ! confirm "Activer le mode P2P (cluster multi-machine) ?"; then
            CLUSTER_ENABLED=false
            return 0
        fi
        CLUSTER_ENABLED=true
    fi

    NODE_ID=$(input_value "Node ID P2P :" "${NODE_ID:-node-1}")
    NODE_ROLE=$(input_value "Role du noeud P2P :" "${NODE_ROLE:-general}")
    NODE_LABEL=$(input_value "Label du noeud P2P :" "${NODE_LABEL:-Mascarade Node 1}")
    MESH_BIND_HOST=$(input_value "IP/VPN mesh du noeud :" "${MESH_BIND_HOST:-}")
    MESH_SCHEME=$(input_value "Schema mesh (http/https) :" "${MESH_SCHEME:-http}")
    CLUSTER_SHARED_KEY=$(input_optional_secret "Cle Bearer inter-noeuds :" "${CLUSTER_SHARED_KEY:-}")
    CLUSTER_REQUEST_TIMEOUT_MS=$(input_value "Timeout cluster (ms) :" "${CLUSTER_REQUEST_TIMEOUT_MS:-5000}")
    CLUSTER_HEARTBEAT_SECONDS=$(input_value "Heartbeat logique (s) :" "${CLUSTER_HEARTBEAT_SECONDS:-30}")
    if [[ "${CLUSTER_MDNS_ENABLED:-false}" == "true" ]]; then
        if ! confirm "Activer la découverte Bonjour/mDNS ?"; then
            CLUSTER_MDNS_ENABLED=false
        fi
    else
        if confirm "Activer la découverte Bonjour/mDNS ?"; then
            CLUSTER_MDNS_ENABLED=true
        fi
    fi
    if [[ "${CLUSTER_MDNS_ENABLED:-false}" == "true" ]]; then
        CLUSTER_MDNS_SERVICE=$(input_value "Nom service mDNS :" "${CLUSTER_MDNS_SERVICE:-_mascarade._tcp.local.}")
        CLUSTER_MDNS_DISCOVERY_TTL_SECONDS=$(input_value "TTL découverte mDNS (secondes) :" "${CLUSTER_MDNS_DISCOVERY_TTL_SECONDS:-60}")
        if [[ "${CLUSTER_MDNS_ADVERTISE:-false}" == "true" ]]; then
            if ! confirm "Publier ce noeud en mDNS (Bonjour) ?"; then
                CLUSTER_MDNS_ADVERTISE=false
            fi
        else
            if confirm "Publier ce noeud en mDNS (Bonjour) ?"; then
                CLUSTER_MDNS_ADVERTISE=true
            fi
        fi
    else
        CLUSTER_MDNS_SERVICE="${CLUSTER_MDNS_SERVICE:-_mascarade._tcp.local.}"
        CLUSTER_MDNS_DISCOVERY_TTL_SECONDS="${CLUSTER_MDNS_DISCOVERY_TTL_SECONDS:-60}"
        CLUSTER_MDNS_ADVERTISE="${CLUSTER_MDNS_ADVERTISE:-false}"
    fi
    if [[ "${CLUSTER_FORWARD_ENABLED:-true}" == "true" ]]; then
        if ! confirm "Garder le forward 'core -> core' actif ?"; then
            CLUSTER_FORWARD_ENABLED=false
        fi
    else
        if confirm "Activer le forward 'core -> core' ?"; then
            CLUSTER_FORWARD_ENABLED=true
        fi
    fi
    CLUSTER_PEERS=$(input_optional_value "Peers P2P (peer|role|url;...) :" "${CLUSTER_PEERS:-}")

    return 0
}

# Correction de confirm_or_auto pour propager le code de retour
confirm_or_auto() {
    local prompt="$1"
    local auto_default="${2:-yes}"
    if [[ "$AUTO_CONFIRM" == true ]]; then
        if [[ "$auto_default" == "no" ]]; then
            info "$prompt [auto-non]"
            return 1
        fi
        info "$prompt [auto-oui]"
        return 0
    fi
    confirm "$prompt"
    return $?
}

configure_native_ollama_defaults() {
    local ollama_port="${OLLAMA_PORT:-11434}"
    OLLAMA_ENABLED="true"
    OLLAMA_HOST_MODE="native"
    OLLAMA_BASE_URL="$(native_ollama_base_url "$ollama_port")"
    DEFAULT_PROVIDER="${DEFAULT_PROVIDER:-ollama}"
    DEFAULT_MODEL="${DEFAULT_MODEL:-llama3.2:3b}"
}

apply_preselected_services() {
    local csv="$1"
    local token
    local valid

    # Réinitialisation propre
    for id in "${SVC_IDS[@]}"; do
        SVC_ON[$id]="0"
    done

    if [[ -z "$csv" ]]; then
        err "Aucun service spécifié"
        return 1
    fi

    IFS=',' read -ra _req_svcs <<< "$csv"
    for token in "${_req_svcs[@]}"; do
        token="${token// /}"
        [[ -z "$token" ]] && continue
        if [[ "$token" == "ops-console" ]]; then
            info "Alias legacy detecte: ops-console -> edge-proxy"
            token="edge-proxy"
        fi
        valid=false
        for id in "${SVC_IDS[@]}"; do
            if [[ "$token" == "$id" ]]; then
                SVC_ON[$id]="1"
                valid=true
                break
            fi
        done
        if [[ "$valid" != true ]]; then
            err "Service inconnu dans --with: '$token'"
            echo "Services valides: ${SVC_IDS[*]}"
            return 1
        fi
    done
    return 0
}

profile_services_csv() {
    local profile="$1"
    local csv=""
    case "$profile" in
        minimal)
            csv="core,api"
            ;;
        standard)
            csv="core,api,edge-proxy,redis,postgres,qdrant,ollama,grafana,prometheus,litellm"
            ;;
        full)
            csv="core,api,edge-proxy,litellm,n8n,langfuse,firecrawl,dify,clickhouse,comfyui,tts,stt,generate-audio,ollama,redis,postgres,qdrant,grafana,prometheus"
            ;;
        apple-silicon)
            csv="core,api,edge-proxy"
            ;;
        *)
            err "Profil inconnu: '$profile'"
            exit 2
            ;;
    esac
    echo "$csv"
}

detect_auto_profile() {
    local cpu_count mem_gib

    if is_apple_silicon; then
        echo "apple-silicon"
        return 0
    fi

    cpu_count=$(system_cpu_count 2>/dev/null || true)
    mem_gib=$(system_total_ram_gib 2>/dev/null || true)

    # Validation des valeurs
    if ! [[ "$cpu_count" =~ ^[0-9]+$ ]] || ! [[ "$mem_gib" =~ ^[0-9]+$ ]]; then
        err "Valeurs système invalides: CPU=$cpu_count, RAM=$mem_gib"
        return 1
    fi

    if [[ "$cpu_count" -ge 8 && "$mem_gib" -ge 24 ]]; then
        echo "full"
    elif [[ "$cpu_count" -ge 4 && "$mem_gib" -ge 8 ]]; then
        echo "standard"
    else
        echo "minimal"
    fi
    return 0
}

apply_profile_selection() {
    local requested="$1"
    local resolved="$requested"
    local csv=""

    if [[ "$requested" == "auto" ]]; then
        resolved=$(detect_auto_profile) || return 1
        info "Profil auto detecte: $resolved"
    fi

    # Validation
    if [[ -z "$resolved" ]]; then
        err "Aucun profil valide selectionne"
        return 1
    fi

    if [[ "$resolved" == "apple-silicon" ]]; then
        if has_native_ollama; then
            configure_native_ollama_defaults
            info "Apple Silicon: Ollama natif detecte via $(command -v ollama)"
        else
            info "Apple Silicon: profil leger sans Ollama docker. Installe Ollama natif pour activer le provider local."
        fi
    fi

    csv=$(profile_services_csv "$resolved") || return 1
    if [[ -z "$csv" ]]; then
        err "Aucun service defini pour le profil $resolved"
        return 1
    fi

    apply_preselected_services "$csv" || return 1
    PROFILE_EFFECTIVE="$resolved"
    return 0
}

hash_files_sha256() {
    if [[ $# -eq 0 ]]; then
        return 1
    fi
    if command -v sha256sum >/dev/null 2>&1; then
        cat "$@" 2>/dev/null | sha256sum | awk '{print $1}'
        return 0
    fi
    if command -v shasum >/dev/null 2>&1; then
        cat "$@" 2>/dev/null | shasum -a 256 | awk '{print $1}'
        return 0
    fi
    return 1
}

install_repo_skills() {
    local skills_src="$REPO_DIR/skills"
    local copied_files=0
    local skill_markers=0
    local pending_changes=0

    if [[ -z "$SKILLS_DEST" ]]; then
        SKILLS_DEST="$HOME/.codex/skills/mascarade"
    fi

    if [[ ! -d "$skills_src" ]]; then
        warn "Dossier skills/ introuvable — skip installation des skills"
        return 0
    fi

    copied_files=$(find "$skills_src" -type f 2>/dev/null | wc -l | tr -d ' ')
    if [[ "$copied_files" == "0" ]]; then
        warn "Aucun fichier skill trouve dans $skills_src"
        return 0
    fi

    mkdir -p "$SKILLS_DEST"

    if command -v rsync >/dev/null 2>&1; then
        pending_changes=$(rsync -ain --out-format='%n' "$skills_src"/ "$SKILLS_DEST"/ 2>/dev/null | grep -c . || true)
        if [[ "$pending_changes" == "0" ]]; then
            info "Skills deja a jour dans $SKILLS_DEST (aucun fichier a copier)"
        else
            info "Mise a jour skills: $pending_changes fichier(s) a synchroniser"
            rsync -a "$skills_src"/ "$SKILLS_DEST"/
        fi
    else
        warn "rsync absent: verification fine impossible, copie complete des skills"
        cp -a "$skills_src"/. "$SKILLS_DEST"/
    fi

    skill_markers=$(find "$skills_src" -type f \( -name 'SKILL.md' -o -name '*.md' \) 2>/dev/null | wc -l | tr -d ' ')

    # Fichier d'index pratique pour retrouver les skills installees.
    {
        echo "# Mascarade skills installes"
        echo "source=$skills_src"
        echo "destination=$SKILLS_DEST"
        echo "installed_at=$(date '+%Y-%m-%d %H:%M:%S')"
        echo "files_total=$copied_files"
        echo "skill_markers=$skill_markers"
        echo ""
        (cd "$skills_src" && find . -type f | sort | sed 's|^\./||')
    } > "$SKILLS_DEST/INDEX.txt"

    ok "Skills installees: $copied_files fichier(s), $skill_markers skill markers -> $SKILLS_DEST"
}

install_repo_ollama_models() {
    local model token pull_rc up_rc
    local pull_output up_output list_output
    local success_count=0
    local fail_count=0
    local skip_count=0
    local dns_fail_count=0
    local list_rc=0
    local model_installed=false
    local -a models=()
    local -a installed_models=()
    local -a failed_models=()
    local has_ollama_service=false

    # Active automatiquement le fallback sudo docker si requis.
    _ensure_docker_access

    if [[ -n "$OLLAMA_MODELS_RAW" ]]; then
        IFS=',' read -ra _csv_models <<< "$OLLAMA_MODELS_RAW"
        for token in "${_csv_models[@]}"; do
            token="${token// /}"
            [[ -n "$token" ]] && models+=("$token")
        done
    else
        case "$OLLAMA_PACK" in
            lite) models=("${OLLAMA_PACK_LITE[@]}") ;;
            heavy) models=("${OLLAMA_PACK_HEAVY[@]}") ;;
            *) models=("${OLLAMA_PACK_BALANCED[@]}") ;;
        esac
        info "Pack Ollama selectionne: $OLLAMA_PACK (${#models[@]} modeles)"
    fi

    if [[ ${#models[@]} -eq 0 ]]; then
        warn "Aucun modele Ollama a telecharger"
        return 0
    fi

    if ! svc_selected "ollama"; then
        info "Activation automatique du service Ollama pour telecharger les modeles"
        SVC_ON[ollama]="1"
    fi

    if [[ ! -f "$REPO_DIR/docker-compose.yml" ]]; then
        err "docker-compose.yml introuvable. Lance d'abord ./setup ou retire --install-repo-llms."
        return 1
    fi

    while IFS= read -r svc; do
        if [[ "$svc" == "ollama" ]]; then
            has_ollama_service=true
            break
        fi
    done < <(docker_compose_cmd -f "$REPO_DIR/docker-compose.yml" config --services 2>/dev/null || true)

    if [[ "$has_ollama_service" != true ]]; then
        err "Le service 'ollama' est absent du docker-compose.yml."
        info "Relance un setup avec ollama selectionne, puis retente --install-repo-llms."
        return 1
    fi

    spin_start "Preparation du service Ollama..."
    up_rc=0
    up_output=$(docker_compose_cmd -f "$REPO_DIR/docker-compose.yml" up -d ollama 2>&1) || up_rc=$?
    spin_stop
    if [[ $up_rc -ne 0 ]]; then
        err "Impossible de demarrer le service ollama (code $up_rc)"
        warn "$(echo "$up_output" | tail -1)"
        return 1
    fi

    list_output=$(docker_compose_cmd -f "$REPO_DIR/docker-compose.yml" exec -T ollama ollama list 2>/dev/null) || list_rc=$?
    if [[ $list_rc -eq 0 ]]; then
        mapfile -t installed_models < <(echo "$list_output" | awk 'NR>1 && $1 != "" {print $1}')
        dbg "Modeles deja presents dans Ollama: ${#installed_models[@]}"
    else
        warn "Impossible de lister les modeles deja presents (verification skip desactivee)"
    fi

    for model in "${models[@]}"; do
        model_installed=false
        if [[ ${#installed_models[@]} -gt 0 ]]; then
            for installed in "${installed_models[@]}"; do
                if [[ "$installed" == "$model" || "$installed" == "$model:latest" ]]; then
                    model_installed=true
                    break
                fi
            done
        fi

        if [[ "$model_installed" == true ]]; then
            info "Modele deja present, skip pull: $model"
            ((skip_count++)) || true
            continue
        fi

        log "Ollama pull $model"
        pull_rc=0
        pull_output=$(docker_compose_cmd -f "$REPO_DIR/docker-compose.yml" exec -T ollama ollama pull "$model" 2>&1) || pull_rc=$?
        if [[ $pull_rc -eq 0 ]]; then
            ok "Modele telecharge: $model"
            ((success_count++)) || true
        else
            warn "Echec telechargement modele: $model (code $pull_rc)"
            warn "$(echo "$pull_output" | tail -1)"
            if echo "$pull_output" | grep -Eq 'lookup registry\.ollama\.ai|no such host|Temporary failure in name resolution|connection refused'; then
                ((dns_fail_count++)) || true
            fi
            failed_models+=("$model")
            ((fail_count++)) || true
        fi
    done

    if [[ $fail_count -gt 0 ]]; then
        err "Telechargement Ollama incomplet: $success_count ok / $skip_count deja presents / $fail_count echec(s)"
        if [[ $dns_fail_count -gt 0 ]]; then
            warn "Probleme DNS/reseau detecte pendant les pulls Ollama."
            info "Depuis le conteneur, registry.ollama.ai n'est pas resolu. Verifie le DNS Docker/host puis relance les pulls."
        fi
        if [[ ${#failed_models[@]} -gt 0 ]]; then
            info "Modeles en echec: ${failed_models[*]}"
        fi
        info "Retry manuel: docker compose up -d ollama && docker compose exec -T ollama ollama pull <modele>"
        return 1
    fi
    ok "Modeles Ollama traites: $success_count telecharge(s), $skip_count deja presents"
    return 0
}

