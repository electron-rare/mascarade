        echo -e "  ${DIM}Tu peux relancer ./setup pour appliquer une nouvelle configuration.${NC}"
        echo ""
        exit 0
    fi
    exit 1
fi

trap 'setup_error_trap' ERR
trap 'warn "Setup interrupted"; setup_exit_trap; exit 1' INT

setup_error_trap() {
    local rc=$?
    local line="${BASH_LINENO[0]:-$LINENO}"
    local cmd="${BASH_COMMAND:-?}"
    err "Setup failed at line ${line}"
    if [[ "$ROLLBACK_ON_FAIL" == true ]]; then
        if [[ "$SETUP_ROLLBACK_DONE" == false ]] && [[ -n "${SETUP_SNAPSHOT_PATH:-}" ]]; then
            SETUP_ROLLBACK_DONE=true
            warn "Rollback automatique via setup snapshot..."
            restore_setup_snapshot "$SETUP_SNAPSHOT_PATH" || warn "Echec du rollback automatique."
        else
            if [[ -z "${SETUP_SNAPSHOT_PATH:-}" ]]; then
                warn "Aucun snapshot à restaurer."
            fi
        fi
    fi
    dbg "Commande en echec: ${cmd} (rc=${rc})"
    exit "$rc"
}

setup_exit_trap() {
    local rc=$?
    if [[ "$rc" -eq 0 ]]; then
        return
    fi
    if [[ "$ROLLBACK_ON_FAIL" == true ]] && [[ "$SETUP_ROLLBACK_DONE" == false ]] && [[ -n "${SETUP_SNAPSHOT_PATH:-}" ]]; then
        SETUP_ROLLBACK_DONE=true
        warn "Rollback automatique via setup snapshot..."
        restore_setup_snapshot "$SETUP_SNAPSHOT_PATH" || warn "Echec du rollback automatique."
    fi
}

if [[ "$OPS_CONSOLE_ONLY" == true ]]; then
    log "Mode --ops-console-only: alias legacy vers Ops Hub React"
    if [[ ! -f "$REPO_DIR/docker-compose.yml" ]]; then
        err "docker-compose.yml introuvable. Utilise ./setup --with core,api,edge-proxy --yes"
        exit 1
    fi
    info "Demarrage du cockpit React via core + api + edge-proxy"
