#!/usr/bin/env bash
# setup — Installateur principal Mascarade
# Usage : ./setup [--help]

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Charger les modules
source "$SCRIPT_DIR/scripts/lib.sh"
source "$SCRIPT_DIR/scripts/services.sh"
source "$SCRIPT_DIR/scripts/prereqs.sh"
source "$SCRIPT_DIR/scripts/compose.sh"

# ── Aide ──
case "${1:-}" in
    -h|--help)
        echo "Usage: ./setup"
        echo ""
        echo "Installateur interactif Mascarade."
        echo "Selectionne les services, configure .env, genere docker-compose.yml."
        echo ""
        echo "Voir aussi :"
        echo "  ./update    Mise a jour des services"
        echo "  ./config    Reconfiguration .env"
        exit 0
        ;;
esac

# ── Liens skills pour assistants CLI ──
ensure_skills_symlinks() {
    local src=""
    local ts
    ts="$(date +%Y%m%d-%H%M%S)"

    # Source prioritaire: skills globaux de la machine, sinon copie repo.
    if [[ -d "/opt/skills-global/all" ]]; then
        src="/opt/skills-global/all"
    elif [[ -d "$REPO_DIR/skills/skills" ]]; then
        src="$REPO_DIR/skills/skills"
    else
        warn "Aucune source de skills trouvee (/opt/skills-global/all ou $REPO_DIR/skills/skills)"
        return 0
    fi

    # Toujours viser le home de l'utilisateur reel (pas /root via sudo).
    local user_home="$HOME"
    if [[ $EUID -eq 0 && -n "${SUDO_USER:-}" && "${SUDO_USER}" != "root" ]]; then
        local sudo_home
        sudo_home="$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6 || true)"
        [[ -n "$sudo_home" ]] && user_home="$sudo_home"
    fi

    local targets=(
        "$user_home/.codex/skills"
        "$user_home/.claude/skills"
        "$REPO_DIR/.claude/skills"
    )

    info "Configuration des symlinks skills -> $src"

    local target parent current backup
    for target in "${targets[@]}"; do
        parent="$(dirname "$target")"
        mkdir -p "$parent"

        if [[ -L "$target" ]]; then
            current="$(readlink "$target" || true)"
            if [[ "$current" == "$src" ]]; then
                ok "Skills link deja OK: $target"
            else
                ln -sfn "$src" "$target"
                ok "Skills link mis a jour: $target -> $src"
            fi
            continue
        fi

        if [[ -e "$target" ]]; then
            backup="${target}.bak.${ts}"
            mv "$target" "$backup"
            warn "Ancien dossier/fichier skills deplace: $backup"
        fi

        ln -s "$src" "$target"
        ok "Skills link cree: $target -> $src"
    done
}

# ── Frontend DevOps: prefer ops-console-v3 when available ──
ensure_ops_console_v3() {
    local candidates=(
        "/opt/docker-studio-ai/tools/dev/ops-console-v3"
        "$REPO_DIR/opt/docker-studio-ai/tools/dev/ops-console-v3"
    )
    local v3_dir=""
    local compose_file=""

    for d in "${candidates[@]}"; do
        if [[ -f "$d/docker-compose.yml" ]]; then
            v3_dir="$d"
            compose_file="$d/docker-compose.yml"
            break
        fi
    done

    if [[ -z "$compose_file" ]]; then
        info "ops-console-v3 non detecte (skip)."
        return 0
    fi

    info "Activation de la webUI DevOps ops-console-v3..."
    docker rm -f zacus-ops-console >/dev/null 2>&1 || true
    if docker compose -f "$compose_file" up -d --build; then
        ok "ops-console-v3 actif (${v3_dir})"
    else
        warn "Echec demarrage ops-console-v3 (compose: $compose_file)"
        return 1
    fi
}

# ── Synchronise la liste des services monitorés avec les services réellement installés ──
sync_ops_managed_containers() {
    local env_local_candidates=(
        "/opt/docker-studio-ai/tools/dev/docker-studio-ai/.env.local"
        "$REPO_DIR/opt/docker-studio-ai/tools/dev/docker-studio-ai/.env.local"
    )
    local env_local=""
    local f=""
    for f in "${env_local_candidates[@]}"; do
        if [[ -f "$f" ]]; then
            env_local="$f"
            break
        fi
    done

    if [[ -z "$env_local" ]]; then
        info "docker-studio-ai/.env.local introuvable (skip sync OPS_MANAGED_CONTAINERS)."
        return 0
    fi

    local candidates=(
        "zacus-ollama"
        "zacus-studio-ai-gateway"
        "zacus-open-webui"
        "zacus-redis"
        "zacus-qdrant"
        "zacus-postgres"
        "zacus-pihole"
        "zacus-homeassistant"
        "zacus-zeroclaw"
        "zacus-discord-mcp-lite"
        "zacus-vibe-mcp-lite"
        "zacus-continue-ai"
        "zacus-pinchtab"
        "tools-litellm"
        "tools-n8n"
        "tools-dify-api"
        "tools-dify-web"
        "tools-dify-worker"
        "tools-firecrawl"
        "tools-langfuse"
        "tools-clickhouse"
    )

    local managed=()
    local name=""
    for name in "${candidates[@]}"; do
        if docker ps -a --filter "name=^/${name}$" --format '{{.Names}}' | grep -qx "$name"; then
            managed+=("$name")
        fi
    done

    # Alias compat monitorings: ops-console (v3 ou legacy).
    if docker ps -a --filter "name=^/ops-console-v3$" --format '{{.Names}}' | grep -qx "ops-console-v3" \
      || docker ps -a --filter "name=^/zacus-ops-console$" --format '{{.Names}}' | grep -qx "zacus-ops-console"; then
        managed+=("ops-console")
    fi

    if [[ ${#managed[@]} -eq 0 ]]; then
        warn "Aucun container detecte pour OPS_MANAGED_CONTAINERS (skip update)."
        return 0
    fi

    local joined
    joined="$(IFS=,; echo "${managed[*]}")"

    if grep -q '^OPS_MANAGED_CONTAINERS=' "$env_local"; then
        sed -i "s#^OPS_MANAGED_CONTAINERS=.*#OPS_MANAGED_CONTAINERS=${joined}#" "$env_local"
    else
        printf '\nOPS_MANAGED_CONTAINERS=%s\n' "$joined" >> "$env_local"
    fi

    ok "OPS_MANAGED_CONTAINERS synchronise (${#managed[@]} services)"
}

# ═══════════════════════════════════════
# Flow principal
# ═══════════════════════════════════════

banner

echo -e "  ${BOLD}Bienvenue dans l'installateur de Mascarade${NC}"
echo -e "  ${DIM}Orchestration LLM multi-providers${NC}"

# ── Etape 1/7 : Selection des services ──
step_progress 1 7 "Selection des services"
checkbox_select

# Verifier qu'au moins un service est choisi
sel_count=0
for id in "${SVC_IDS[@]}"; do
    [[ "${SVC_ON[$id]}" == "1" ]] && ((sel_count++)) || true
done
if [[ $sel_count -eq 0 ]]; then
    err "Aucun service selectionne."
    exit 1
fi

# ── Etape 2/7 : Resolution des dependances ──
step_progress 2 7 "Resolution des dependances"
resolve_dependencies

echo ""
echo -e "  ${BOLD}Services selectionnes :${NC}"
for id in "${SVC_IDS[@]}"; do
    if svc_selected "$id"; then
        echo -e "    ${GREEN}✓${NC} ${SVC_LABEL[$id]} ${DIM}(:${SVC_PORT[$id]})${NC}"
    fi
done
echo ""
if ! confirm "Continuer avec cette selection ?"; then
    exit 0
fi

# ── Etape 3/7 : Prerequis ──
step_progress 3 7 "Verification des prerequis"
check_prerequisites

# ── Etape 4/7 : Configuration .env ──
step_progress 4 7 "Configuration .env"

# Charger .env existant
load_env "$REPO_DIR/.env" 2>/dev/null || true

if [[ -f "$REPO_DIR/.env" ]]; then
    if confirm "Un fichier .env existe. Le reconfigurer ?"; then
        collect_module_configs
    else
        ok ".env conserve"
    fi
else
    collect_module_configs
fi

# ── Etape 5/7 : Generation docker-compose.yml ──
step_progress 5 7 "Generation docker-compose.yml"

if [[ -f "$REPO_DIR/docker-compose.yml" ]]; then
    backup_file "$REPO_DIR/docker-compose.yml"
fi
generate_compose "$REPO_DIR/docker-compose.yml"
ok "docker-compose.yml genere"

# Ecrire le .env
write_env_file "$REPO_DIR/.env"
chmod 600 "$REPO_DIR/.env"

# ── Etape 6/7 : Dependances locales ──
step_progress 6 7 "Installation des dependances"

if svc_selected "core" && command -v python3 &>/dev/null; then
    spin_start "Installation du Core Python..."
    cd "$REPO_DIR/core"
    if [[ ! -d ".venv" ]]; then
        python3 -m venv .venv
    fi
    .venv/bin/pip install --upgrade pip -q 2>&1 | tail -1
    .venv/bin/pip install -e ".[dev]" -q 2>&1 | tail -1
    cd "$REPO_DIR"
    spin_stop
    ok "Dependances Python installees"
fi

if svc_selected "api" && command -v npm &>/dev/null; then
    spin_start "Installation de l'API Node.js..."
    cd "$REPO_DIR/api"
    npm install --silent 2>&1 | tail -1
    npm run build --silent 2>&1 || true
    cd "$REPO_DIR"
    spin_stop
    ok "Dependances Node.js installees"
fi

# Liens skills (Codex/Claude) pour que la machine retrouve les skills au premier run.
ensure_skills_symlinks

# Tests optionnels
if svc_selected "core" && [[ -d "$REPO_DIR/core/.venv" ]]; then
    if confirm "Lancer les tests ?"; then
        spin_start "Tests en cours..."
        cd "$REPO_DIR/core"
        local_test_result=0
        .venv/bin/python -m pytest -q 2>&1 || local_test_result=$?
        cd "$REPO_DIR"
        spin_stop
        if [[ $local_test_result -eq 0 ]]; then
            ok "Tests passes"
        else
            warn "Certains tests ont echoue"
        fi
    fi
fi

# ── Etape 7/7 : Demarrage ──
step_progress 7 7 "Demarrage des services"

menu_select "Comment proceder ?" \
    "Demarrer maintenant (docker compose up)" \
    "Ne pas demarrer (je le ferai plus tard)"

case $MENU_RESULT in
    0)
        spin_start "Build des images..."
        docker compose -f "$REPO_DIR/docker-compose.yml" build 2>&1 | tail -5
        spin_stop
        ok "Images pretes"

        spin_start "Demarrage des containers..."
        docker compose -f "$REPO_DIR/docker-compose.yml" up -d 2>&1
        spin_stop
        ok "Containers lances"

        echo ""
        log "Health checks..."
        sleep 4

        if svc_selected "core"; then
            health_check "http://localhost:${CORE_PORT:-8100}/health" "Core" 5 2
        fi
        if svc_selected "api"; then
            health_check "http://localhost:${API_PORT:-3000}/health" "API" 5 2
        fi

        # Garantit la webUI DevOps moderne sur les machines qui ont docker-studio-ai.
        ensure_ops_console_v3 || true
        # Aligne les services monitorés sur les services effectivement installés.
        sync_ops_managed_containers || true
        ;;
    1)
        ok "docker-compose.yml pret. Lance : docker compose up -d"
        ;;
esac

# ── Resume final ──
echo ""
line
echo ""
echo -e "  ${GREEN}${BOLD}Installation terminee !${NC}"
echo ""

show_status_table

echo -e "  ${BOLD}Commandes utiles :${NC}"
echo -e "  ${DIM}├${NC} docker compose ps              ${DIM}# Statut${NC}"
echo -e "  ${DIM}├${NC} docker compose logs -f          ${DIM}# Logs${NC}"
echo -e "  ${DIM}├${NC} docker compose down             ${DIM}# Arreter${NC}"
echo -e "  ${DIM}├${NC} ./update                        ${DIM}# Mise a jour${NC}"
echo -e "  ${DIM}└${NC} ./config                        ${DIM}# Reconfigurer${NC}"

if svc_selected "api" && [[ -n "${MASCARADE_API_KEY:-}" ]]; then
    echo ""
    echo -e "  ${BOLD}Test rapide :${NC}"
    echo -e "  curl -sH 'Authorization: Bearer \$MASCARADE_API_KEY' \\"
    echo -e "    http://localhost:${API_PORT:-3000}/api/agents/metrics | python3 -m json.tool"
fi

echo ""
line
echo -e "  ${DIM}mascarade v0.1.0${NC}"
echo ""
