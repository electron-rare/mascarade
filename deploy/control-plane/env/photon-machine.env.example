PORT=3000
NODE_ENV=production
CLUSTER_NAME=mascarade-cluster
CONTROL_PLANE_DB_PATH=/var/lib/mascarade/control-plane.sqlite
CONTROL_PLANE_LOG_PATH=/var/log/mascarade/control-plane.log
CONTROL_PLANE_SHARED_TOKEN=change-me
ROUTELLM_THRESHOLD=0.58
ROUTELLM_CHEAP_PROVIDER=ollama
ROUTELLM_CHEAP_MODEL=qwen3.5:9b
ROUTELLM_STRONG_PROVIDER=claude
ROUTELLM_STRONG_MODEL=claude-sonnet-4-6
