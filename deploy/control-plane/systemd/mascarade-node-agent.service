[Unit]
Description=Mascarade Node Heartbeat Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/mascarade/api
EnvironmentFile=/etc/mascarade/node-agent.env
ExecStart=/usr/bin/node /opt/mascarade/api/src/agent/heartbeat-agent.js
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
