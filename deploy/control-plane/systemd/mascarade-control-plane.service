[Unit]
Description=Mascarade Control Plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/mascarade/api
EnvironmentFile=/etc/mascarade/control-plane.env
ExecStart=/usr/bin/node /opt/mascarade/api/src/server.js
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
