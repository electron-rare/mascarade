FROM python:3.11-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends systemd ca-certificates docker.io \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY deploy/ops_agent/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY core /tmp/mascarade-core
RUN pip install --no-cache-dir /tmp/mascarade-core \
  && rm -rf /tmp/mascarade-core

COPY deploy/ops_agent/app.py /app/app.py

EXPOSE 9200

CMD ["python", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "9200"]
