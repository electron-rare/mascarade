ARG PYTHON_IMAGE=python:3.10-slim-bookworm
FROM ${PYTHON_IMAGE}

ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
ARG TORCH_VERSION=2.1.0
ARG TORCHAUDIO_VERSION=2.1.0
ARG TORCHVISION_VERSION=0.16.0
ARG TORCHTEXT_VERSION=0.16.0
ARG XFORMERS_VERSION=0.0.22.post7
ARG AUDIOCRAFT_VERSION=1.3.0

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/root/.cache/huggingface

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ffmpeg \
    git \
    libavcodec-dev \
    libavdevice-dev \
    libavfilter-dev \
    libavformat-dev \
    libavutil-dev \
    libsndfile1 \
    libsndfile1-dev \
    libswresample-dev \
    libswscale-dev \
    pkg-config \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY deploy/audio_gen_api/requirements.txt /app/requirements.txt
RUN pip install --upgrade pip setuptools wheel \
 && pip install -r /app/requirements.txt \
 && pip install --index-url "${TORCH_INDEX_URL}" \
      "torch==${TORCH_VERSION}" \
      "torchaudio==${TORCHAUDIO_VERSION}" \
      "torchvision==${TORCHVISION_VERSION}" \
      "torchtext==${TORCHTEXT_VERSION}" \
 && pip install "xformers==${XFORMERS_VERSION}" \
 && pip install "audiocraft==${AUDIOCRAFT_VERSION}"

COPY deploy/audio_gen_api/app.py /app/app.py

ENV GENERATE_AUDIO_HOST=0.0.0.0 \
    GENERATE_AUDIO_PORT=9000 \
    GENERATE_AUDIO_ENGINE=audiogen \
    GENERATE_AUDIO_MODEL=facebook/audiogen-medium \
    GENERATE_AUDIO_RUNTIME=auto \
    GENERATE_AUDIO_TORCH_VARIANT=cpu

EXPOSE 9000

CMD ["sh", "-lc", "python -m uvicorn app:app --host ${GENERATE_AUDIO_HOST:-0.0.0.0} --port ${GENERATE_AUDIO_PORT:-9000}"]
