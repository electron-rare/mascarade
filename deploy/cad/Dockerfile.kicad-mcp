FROM node:22-bookworm AS builder

WORKDIR /src

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

COPY . .
RUN npm run build

FROM kicad/kicad:9.0

ENV DEBIAN_FRONTEND=noninteractive

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3-pip ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/kicad-mcp

COPY --from=builder /usr/local/bin/node /usr/local/bin/node

COPY --from=builder /src/package.json ./package.json
COPY --from=builder /src/package-lock.json ./package-lock.json
COPY --from=builder /src/node_modules ./node_modules
COPY --from=builder /src/dist ./dist
COPY --from=builder /src/python ./python
COPY --from=builder /src/requirements.txt ./requirements.txt
COPY --from=builder /src/tsconfig.json ./tsconfig.json

RUN python3 -m pip install --break-system-packages --no-cache-dir \
      -r requirements.txt \
      -r python/requirements.txt

ENV KICAD_PYTHON=/usr/bin/python3

CMD ["sleep", "infinity"]
