# .secretsignore - Patterns for false positive secret detection
# Docker image SHA256 hashes and environment variable references are not secrets

# Scripts that contain Docker image SHAs and password env var references
scripts/compose.sh
scripts/modules/*.sh

# Task specification files contain UUIDs for task IDs, not actual secrets
.auto-claude/specs/*/implementation_plan.json
.auto-claude/specs/001-project-status-with-associated-repos/implementation_plan.json
